  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>It\u2019s 2098.</b>\n\nThree years ago, a massive solar storm shattered
    the grid. Communications failed. The internet collapsed. The world shrank into
    emergency mode\u2026 for most.\r\n\nBefore the collapse, Astrid and Elijah\u2014both
    eighteen\u2014planned to study astronomy together. Everyone thought they\u2019d
    drift apart. But their love for the stars kept them on the same path.\r\n\nAfter
    the blackout, most gave up watching the skies. Not Elijah. He\u2019s been living
    at an old observatory, clinging to the dream. Astrid stayed behind\u2014until
    now.\r\n\nShe\u2019s finally made the trip north, hoping to find him.\r\n\nBut
    he\u2019s not there."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: d20834c64a4d78e48be698eb58cd78fa, type: 2}
