  m_Name: RecoveryBoardLetter
  m_EditorClassIdentifier: 
  Category: 2
  Prefab: {fileID: 246285763888720079, guid: 5e4623331c4e1174e9b6f67c2fa9669b, type: 3}
  Interactable: {fileID: 2204356997181352041, guid: 5e4623331c4e1174e9b6f67c2fa9669b, type: 3}
  TextFields:
  - "Ministry of Information Recovery\nOffice of Astronomical Compliance\n\nNotice
    of Suspension \u2013 Unauthorized Communications"
  - "\nAstrid,\n\nFollowing the recent audit of your radio transmission logs, the
    Office of Astronomical Compliance has determined that you have incurred three
    (3) disciplinary strikes for misuse of communication channels reserved exclusively
    for approved astronomical coordination. [optional]Specifically, your decision
    to contact a fellow astronomer regarding non-critical astral identification constitutes
    a violation of Regulation 7-14b.\n\nPer Directive 22-e, your full access to Recovery
    Board\u2013issued astronomical equipment is hereby suspended. This suspension
    will remain in effect until you have completed your pending celestial identification
    assignments to the satisfaction of the Recovery Board\u2019s reviewing officers.\n\nIn
    recognition of your prior service, the Board is prepared to grant probational
    reinstatement of equipment privileges once you have successfully completed the
    mandatory identification of designated stellar bodies within the Eridanus constellation.
    This task has been logged to your work docket and will be evaluated with heightened
    scrutiny.\n\nYour cooperation is important for us to so that we may continue
    to map the stars for a greater tomorrow.\n\nBy order of the Recovery Board,\n[Autumn's
    character/title here]"
  StreamingVisuals: []
  DefaultPinnedPos: {x: 0.6, y: -0.322, z: 0}
