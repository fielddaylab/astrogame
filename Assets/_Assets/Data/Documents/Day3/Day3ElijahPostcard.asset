  m_Script: {fileID: 11500000, guid: b3b563d715eb6c64c9b6c779e47f3352, type: 3}
  m_Name: Day3ElijahPostcard
  m_EditorClassIdentifier: 
  Category: 0
  Prefab: {fileID: 6625514644646704096, guid: 66ca270a9c5bfc54492cc14d252c3e4e, type: 3}
  Interactable: {fileID: 5048261325816738630, guid: 66ca270a9c5bfc54492cc14d252c3e4e, type: 3}
  TextFields:
  - Nemean Lion
  - "A-\r\nJust finished up at Stations 5 and 6 in northern Minnesota. The Gunflint
    Trail is beautiful\u2014wish you were here. Six down, six to go, and then I\u2019ll
    be back with you. I hope you\u2019re there when I get home.\r\n\nThis drawing
    is Leo\u2014the golden lion. First task of Hercules. The lion was supposed to
    be unkillable, coat made of gold. But he pulled it off. That story\u2019s been
    stuck in my head. Everything feels impossible right now, but maybe that makes
    it easier to just try. You stop worrying about getting it right. You just do
    the work. Hope it matters.\r\n\nYou\u2019ve seen my notes, so you know why Leo\u2019s
    on my mind. I just hope we can figure this out in time. People need to know.\r\n\nEveryone
    in Duluth was talking about you\u2014like, \u201CWait, who\u2019s this girl mapping
    the sky?\u201D I think you impressed them. Your dad\u2019s not thrilled with
    me, but he\u2019ll come around. He always does.\n\nLove,\r Elijah"
  StreamingVisuals:
  - VisualAssetPath: Postcards/leo_anim.webm
    LowResAssetPath: 
  - VisualAssetPath: Postcards/LOW_RES_Leo.png
    LowResAssetPath: Postcards/LOW_RES_Leo.png
  DefaultPinnedPos: {x: -1.15, y: 0, z: 0}
