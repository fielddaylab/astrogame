  m_Script: {fileID: 11500000, guid: b3b563d715eb6c64c9b6c779e47f3352, type: 3}
  m_Name: Day4ElijahPostcard
  m_EditorClassIdentifier: 
  Category: 0
  Prefab: {fileID: 6625514644646704096, guid: 66ca270a9c5bfc54492cc14d252c3e4e, type: 3}
  Interactable: {fileID: 5048261325816738630, guid: 66ca270a9c5bfc54492cc14d252c3e4e, type: 3}
  TextFields:
  - ' Hercules and the Dragon'
  - "Astrid\u2014\r\n\r\nYou did it. I worked on those puzzles for months\u2014but
    you know me, I hate puzzles. I thought the data was corrupted. It\u2019s starting
    to work. The tech I\u2019ve been installing at the first 9 stations is online,
    and everything\u2019s syncing up. I'm headed through Michigan and will be back
    to you soon.\r\n\r\nIf you can get through the next two puzzles, the satellite
    decryption will unlock. Full access. It\u2019ll change everything\u2014messaging,
    data, even long-range comms. No more waiting weeks to hear from each other or
    dealing with the Office of Signal Integrity (OSI)  - or the Office of Spies and
    Interference....\r\n\r\nThe postcard\u2019s Draco. Thought it fit\u2014time to
    face the dragon. Hercules\u2019s last task.\r\n\r\nYou\u2019ve turned on the
    blue light, right?\r\n\r\nI\u2019ll see you soon. I CAN NOT WAIT!\r\n\r\n\u2014E"
  StreamingVisuals:
  - VisualAssetPath: Postcards/draco_branches_anim.webm
    LowResAssetPath: 
  - VisualAssetPath: Postcards/Draco.png
    LowResAssetPath: Postcards/LOW_RES_Draco.png
  DefaultPinnedPos: {x: -0.85, y: 0, z: 0}
  ZoomOffsetOverride: {x: 0, y: 0, z: 0}
  CloseEnabled: 1
