  Category: 2
  Prefab: {fileID: 6625514644646704096, guid: 1f6a6789373206e498f996cb54aeedb1, type: 3}
  Interactable: {fileID: 0}
  TextFields:
  - From Aunt Martha
  - "Dear Astrid,\r\n \r\nWell, well, well. I\u2019m guessing you haven\u2019t tracked
    down Elijah yet . . . because he just showed up on my doorstep. Funny, isn\u2019t
    it? If you hadn\u2019t run off, you\u2019d be with him right now.\r\n \r\nDon\u2019t
    bother writing to Elijah here. He\u2019s already back on the road. Something
    about charting the stars. I told him it was a fool\u2019s errand. What do the
    stars matter? We need to focus on what\u2019s important. Food. Clean water. Medicine.
    \r\n \r\nI don\u2019t mean to sound harsh, Astrid. But it\u2019s time to come
    home. This town needs you. Remember, the roads are dangerous. Stay alert. And
    see if you can get your hands on some azithromycin\u2014we\u2019re in short supply. 
    \r\n \r\nWith love,\r\nAunt Martha\r\r"
  - "P.S. Elijah asked me to pass along this photo. Tell him to send it himself next
    time\u2014I\u2019m not the US Postal Service. "
  StreamingVisuals: []
  DefaultPinnedPos: {x: -0.91, y: -0.65, z: 0}
  ZoomOffsetOverride: {x: 0, y: 0, z: 0}
  CloseEnabled: 1
