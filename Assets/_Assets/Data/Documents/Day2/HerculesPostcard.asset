  m_Script: {fileID: 11500000, guid: b3b563d715eb6c64c9b6c779e47f3352, type: 3}
  m_Name: HerculesPostcard
  m_EditorClassIdentifier: 
  Category: 2
  Prefab: {fileID: 6625514644646704096, guid: 784d78f741f159b4fa345687039dccf0, type: 3}
  Interactable: {fileID: 5048261325816738630, guid: 784d78f741f159b4fa345687039dccf0, type: 3}
  TextFields:
  - To A from E
  - "A\u2014\r\nYou won\u2019t believe this\u2014I\u2019m at your aunt\u2019s house!
    I was trying to surprise you. Guess you had the same idea. Star-crossed lovers,
    huh? It was written in the stars. Fate can really suck sometimes.\n\r\nI\u2019ve
    been staring at Hercules a lot lately, so I drew it for you.He also had 12 labors...jobs
    to do. I kind of feel like him\u2014wandering, overloaded, trying to fix things
    no one else believes in. I\u2019m bouncing between CERES stations, updating tech
    for something I\u2019ve been building. If it works... it could change everything.\r\n\nThe
    puzzle still haunts me. If I don\u2019t solve it soon, it might all fall apart.\r\nI
    just want to be with you at World\u2019s End. Got to run...\r\n\nLove you, E"
  StreamingVisuals:
  - VisualAssetPath: Postcards/hercules_anim.webm
    LowResAssetPath: 
  - VisualAssetPath: Postcards/Hercules.png
    LowResAssetPath: Postcards/LOW_RES_Hercules Postcard.png
  DefaultPinnedPos: {x: 0, y: 1.25, z: 0}
