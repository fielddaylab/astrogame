#basePath Day0

::OpeningPrelude
@trigger    BeginPrelude
@boostScore 100
@cutscene

$call PreludePostcard->Deactivate()
$call ChapterTitles->PrepareTransition(true)
$wait 0.5
$call ChapterTitles->DisplayIntroTitles()
$set temp:preludeSkySelection = false

$wait 1
$call Perseids_ParticlesA->PlayEffects()
$call ChapterTitles->FinishTransition()
$wait 2

{@Astrid}   Test Dialogue
{@Astrid}   Come on, Elijah, where are you? It's already starting! $[prelude/Astrid/pre_a_01]

$wait 1
$call MovePhoneToUpper->PlayTween()
$call PhoneAudio->Play()
$wait 3.1

{@Elijah}   Hey! Sorry I'm late. $[prelude/Elijah/pre_e_01]
{@Astrid}   About time. I thought you were gonna miss it.  $[prelude/Astrid/pre_a_02]
{@Elijah}   Yeah, I set like three alarms... and then slept through them. Next year I'll try four. $[prelude/Elijah/pre_e_02]
{@Astrid}   Don't worry. Next year we'll be together. Like, actually together. $[prelude/Astrid/pre_a_03]
{@Elijah}   I'm literally counting down the days. It's gonna be so cool studying astronomy with you. $[prelude/Elijah/pre_e_03]
$wait 1
$call PreludePostcard->Activate()
$call PreludePostcard->SlideIn()
{@Elijah}   Did you get my birthday card? I drew you as Perseus. $[prelude/Elijah/pre_e_04]
{@Astrid}   It's really great, Elijah . . . but I don't think I'm as cool as Perseus. $[prelude/Astrid/pre_a_04]
{@Elijah}   Girl, trust me. You're the stuff of Greek myth. $[prelude/Elijah/pre_e_05]

$call Perseids_ParticlesB->PlayEffects()
{@Astrid}	Dudeeeee.  $[prelude/Astrid/pre_a_05]
{@Elijah}   (*chuckle*) Sorry. $[prelude/Elijah/pre_e_06]
$call PreludePostcard->SlideOut()
$call PreludePostcard->Deactivate()

// {@Astrid} Okay, let's focus. The Perseids won't wait for us. $[prelude/Astrid/pre_a_06]
// {@Astrid} Bet I can find the Perseus constellation first.  $[prelude/Astrid/pre_a_07]
// {@Elijah} Hey, not fair. You've got a head start! $[prelude/Elijah/pre_e_07]
// {@Astrid} Bro, you have a telescope. $[prelude/Astrid/pre_a_08]
// {@Elijah} Point taken. $[prelude/Elijah/pre_e_08]
$call PerseidsClickable->ActivateMeteors()
{@Astrid}   Okay, Dad said the Perseids start at the Perseus constellation. $[prelude/Astrid/pre_a_09]
{@Astrid}   I need to find the place where the meteors look like they're coming from. $[prelude/Astrid/pre_a_10]

$call   HintModals->SlideInFromLeft("Prelude", 0.4)
$start .InstructionReminder

:: InstructionReminder
$call Wait(8)
$if !temp:preludeSkySelection
    $call   HintModals->Wiggle("Prelude")
    {@Astrid}   Okay, Dad said the Perseids start at the Perseus constellation. $[prelude/Astrid/pre_a_09(1)]
    {@Astrid}   I need to find the place where the meteors look like they're coming from. $[prelude/Astrid/pre_a_10(1)]
    $loop
$endif

:: StarClicked
@trigger	StarClicked
@when		actorId == "PerseidsClickable"
@cutscene
@interrupt

$start .FadeOutStarClick

$set temp:preludeSkySelection = true
$call   HintModals->Hide("Prelude", 0.2)
{@Astrid}   Got it! $[prelude/Astrid/pre_a_11]
$wait 0.5
// {@Elijah} Ugh. You win again. $[prelude/Elijah/pre_e_09]
{@Astrid}   It's so wild. In ancient times they used the stars to tell their fates, to navigate... and they had to figure it all out from scratch. That must've been stressful. $[prelude/Astrid/pre_a_12]
{@Elijah}   I don’t know. Sounds sort of fun to me. $[prelude/Elijah/pre_e_10]

$call Aurora->FadeIn()
$call Signal("FadeOutCityAmb")
$wait 3
$call Signal("WalkForward")

{@Astrid}   Whoa. Elijah, are you seeing this? $[prelude/Astrid/pre_a_13]
$call FakeBloomExtra->FadeIn()
$call FakeBloom->FadeIn()
$call Signal("FadeOutHorizon")
$call Signal("IncreaseLightIntensity")

{@Elijah}   Astrid—you’re breaking up— $[prelude/Elijah/pre_e_11]
{@Astrid}   Is that the northern lights? $[prelude/Astrid/pre_a_14]
{@Astrid}   Whoa. It’s so bright! $[prelude/Astrid/pre_a_15]

{@Elijah}   {vox-overlap -0.5} —something’s not right— $[prelude/Elijah/pre_e_12]
$call CityFlicker->PlayTimeline()
{@Astrid}   Elijah, can you hear me? $[prelude/Astrid/pre_a_16]
{@Elijah}    {vox-overlap -0.5} —readings are off the charts— $[prelude/Elijah/pre_e_13]

{@Astrid}   Hello? Elijah? $[prelude/Astrid/pre_a_17]
$wait 4

$call Signal("DisconnectView")
$wait 5
$call Signal("RunAway")

$wait 5
$call Signal("CutToBlack")
$wait 2

$call LoadDay("Day1", "HardCut")

:: FadeOutStarClick
$call PerseidsClickable->SetClickable(false)
$wait 2
$call PerseidsClickable->SetActive(false)
