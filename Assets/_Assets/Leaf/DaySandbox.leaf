#basePath	DaySandbox

:: Preload
@function ScenePreload
$call InitUpdateMasks()
$call SetInstrumentUnlocked(CoordinateInstrument, true)
$call SetInstrumentUnlocked(PhotometerInstrument, true)
$call SetInstrumentUnlocked(BlueWavelength, true)
$call SetInstrumentUnlocked(InfraredWavelength, true)
$call SetInstrumentUnlocked(ColorInstrument, true)
$call SetInstrumentUnlocked(TemperatureInstrument, true)
$call SetInstrumentUnlocked(SpectrometerInstrument, true)
$call SetInstrumentUnlocked(HistoricalDataInstrument, true)
$call SetInstrumentUnlocked(HistoricalDataModeToggle, true)
$call SetRadioFrequency(137, true)
$call SetChannelActive(Unlocks_Active, false)
$call MonitorPower->Deactivate()
$start Observatory.ResetSubtitlePosition

$call StopPuzzleMode()
$call StopOpenMode()

:: BeginDay
@trigger    SceneReady
@boostScore 100
@who    Astrid

$call StartNeutrinoNavigation()
$call Wait(0.5)
$call SetInputState(true)

:: NeutrinoNavigationComplete
@trigger    NeutrinoNavigationComplete
@once

$call StopNeutrinoNavigation()
{@Radio} Neutrino Origin Detected
$call StartOpenMode()