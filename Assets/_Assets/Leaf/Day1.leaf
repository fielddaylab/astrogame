#basePath	Day1

// #region Preload

:: Preload
@function   ScenePreload
$call InitUpdateMasks()
$call ToggleDeskPicture()
$call SetInputState(false)
$call StopPuzzleMode()
$call StopOpenMode()
$call IntroCutscene->PrepareCutscene()

$call PreloadDocument("ElijahIntro")
$call PreloadDocument("Day1Cal")

$call MonitorUI->PowerOff()
$call SetRefGuidePagesLocked(true)
$call SetRefPageActive("ConstellationPerseusCompleted", false)
$call SetRefPageActive("ConstellationHerculesCompleted", false)
$call SetRefPageActive("ConstellationLeoCompleted", false)
$call SetRefPageActive("ConstellationDracoCompleted", false)
$call SetRefPageActive("ConstellationAndromedaCompleted", false)

$call PreloadMusic("Music.Gently-Falling")

$call SetRadioFrequency(100, true)

$set temp:readyForUpgrade = false

$call SetChannelActive(Unlocks_Active, false)
$call SetChannelActive(IceCube, false)
$call ChapterTitles->PrepareTransition(true)
$start Observatory.ResetSubtitlePosition
$call SpawnDocument("ElijahIntro")
$call SpawnDocument("Day1Cal")
$call SetStickyFirstPage(7)

// #endregion

// #region Intro

:: OpeningCutscene
@trigger SceneReady
@cutscene

$call PlayMusic("Music.Gently-Falling", 1)
$wait 1
$call ChapterTitles->DisplayChapterTitles()
$call IntroCutscene->BeginCutscene()
$call ChapterTitles->FadeOutBackground()
$wait 2
$call TelescopeLook(155, -30)
$wait 3
$call ChapterTitles->FinishTransition()

:: ArrivalAtTheShed
@trigger    CutsceneEnd
@when   cutsceneId == "IntroCutscene"
@cutscene

$set temp:powerButtonHint = false
$set temp:pressedPowerButton = false
$wait 1

$call IntroSfx->Play()
$wait 0.1
$call IntroSfx2->Play()
$wait 3
$call SetInputState(true)

{@Astrid}   Whoa. This place has really changed. Elijah, where are you?	$[level1/Astrid/l1_a_01]
$start .PowerButtonHint

:: PowerButtonHint
$wait 30
$if !temp:powerButtonHint, !temp:pressedPowerButton
    $call HintModals->SlideInFromRight("MonitorPower", 0.4)
    $set temp:powerButtonHint = true
$else
    $call HintModals->Wiggle("MonitorPower")
$endif
$wait 30

$if !temp:pressedPowerButton
    $call HintModals->Wiggle("MonitorPower")
    {@Astrid}	I should power this thing up. Maybe it'll help me figure out where Elijah went. 	$[level1/Astrid/l1_a_02]
    $loop
$endif

:: InspectElijahBackSoon
@trigger    DocumentInspectStart
@when   documentId == "ElijahIntro", !temp:fakeCutscene
@cutscene
@once

{@Astrid}   You'll be back soon? Back from where? $[level1/Astrid/l1_a_01a]
$goto .PowerButtonHint

:: PressedPowerButton
@trigger OnLabInteraction
@when   actorId == "MonitorPower", !temp:pressedPowerButton
@boostScore 100
@priority High
@interrupt
@cutscene

$set temp:pressedPowerButton = true
$set temp:introRadioHint = false
$set temp:introRadioChannelTuned = false
$wait 0.1
$call ComputerBootSound->Play()
$call MonitorPower->Deactivate()
$if temp:powerButtonHint
    $set temp:powerButtonHint = false
    $call HintModals->Hide("MonitorPower", 0.2)
$endif
$call MonitorUI->ShowCERESLogo()
$call MonitorUI->CERESLogoToCorner(0.5)
$call ConsoleCommandLine->PlayConsoleTextAndWait("SystemBoot")
$call ConsoleCommandLine->HideConsole()
$wait 1
$call MonitorUI->ShowElement("CommError")
$wait 1
$call MonitorUI->ShowElement("CommErrorMsg1")
$wait 0.25
$call MonitorUI->HideElement("CommErrorMsg1")
$wait 0.25
$call MonitorUI->ShowElement("CommErrorMsg2")
$call SetChannelActive(IceCube, true)
$wait 0.5

$start .TuneRadioHint

:: TuneRadioHint
$wait 10
$if !temp:introRadioHint, !temp:introRadioChannelTuned
    $set temp:introRadioHint = true
    $call HintModals->SlideInFromRight("CeresRadioHint", 0.4)
$else
    $call HintModals->Wiggle("CeresRadioHint")
$endif
$if !temp:introRadioChannelTuned
    // {@Astrid}	Okay... I need to tune the radio to 137 megahertz. 	$[level1/Astrid/l1_a_03]
    $loop
$endif

:: TuneToIceCubeIntro
@trigger    RadioChannelListenStart
@when       channelId == "IceCube"
@priority High
@boostScore 1000
@interrupt
@once

$set temp:fakeCutscene = true
$set temp:introRadioChannelTuned = true
$call SetRadioFrequency(137, true)
$call SetRadioDialLocked(true)
$if temp:introRadioHint
    $set temp:introRadioHint = false
    $call HintModals->Hide("CeresRadioHint", 0.2)
$endif
$call MonitorUI->HideElement("CommError")
$call MonitorUI->HideElement("CommErrorMsg2")
$wait 1
$call MonitorUI->CERESLogoToCenter(0.5)
$wait 1
$call MonitorUI->ShowElement("LinkEstablished")
$wait 1
$call MonitorUI->HideElement("LinkEstablished")
$call SetChannelActive(IceCube, true)

$call WaitForMovedToView("Right")
{@Radio}    CERES HQ to Station 12. Elijah, do you copy? $[level1/radio_lady/l1_r_01]
{@Radio}    Please log in and provide status report. $[level1/radio_lady/l1_r_02]
{@Astrid}   Whoa, a radio signal! $[level1/Astrid/l1_a_04]
{@Astrid}   I thought radio channels were supposed to be super regulated. How does Elijah even have this? $[level1/Astrid/l1_a_05]
{@Radio}    Station 12, please log in and report.	$[level1/radio_lady/l1_r_03]
{@Astrid}   Ok, here goes. $[level1/Astrid/l1_a_06]

$start Observatory.PathToInstruments
$wait 0.5
$call ConsoleCommandLine->PlayConsoleText("AstridLogin")
$wait 1

{@Dad}      ...I told you, he's not there. Astrid, is that you? 	$[level1/dad/l1_d_01]

{@Astrid}	(*gasp*) Dad!? I—I can’t believe it. Are you still at the South Pole? Can you hear me? $[level1/Astrid/l1_a_07]
{@Dad}	    Loud and clear. Well... not clear, exactly. But you know what I mean.	$[level1/dad/l1_d_02]
{@Dad}	    It’s so good to hear your voice, Little Bear.	$[level1/dad/l1_d_03]
{@Astrid}	Hold on, why are you calling Elijah's radio? Do you know where he went? 	$[level1/Astrid/l1_a_08]
{@Dad}	    It’s sort of a long story.	$[level1/dad/l1_d_04]
{@Dad}	    My team here at IceCube is working to rebuild the knowledge of the cosmos that was lost during the coronal mass ejection two years ago.	$[level1/dad/l1_d_05]
{@Dad}	    We've joined up with a network of citizen astronomers around the world. We call it CERES. 	$[level1/dad/l1_d_06]
{@Astrid}	Ceres... I think Elijah told me about her once. The Roman goddess of Earth and agriculture.	$[level1/Astrid/l1_a_09]
{@Dad}	    Yeah, Elijah loved the name. I told him it was just an acronym, but I swear, everything I tell that kid goes in one ear and out the other. 	$[level1/dad/l1_d_07]
{@Astrid}	So... where is he? 	$[level1/Astrid/l1_a_10]
{@Dad}	    A few weeks ago, he reached out about some mysterious side project. He said he had to go out on the road. 	$[level1/dad/l1_d_08]
{@Dad}	I think he called it... "Project Hercules."	$[level1/dad/l1_d_08a]
{@Dad}	    I tried to stop him, but ... I mean, you know how he is.	$[level1/dad/l1_d_09]
{@Astrid}	I don't get it. Why would he leave when he knew I was coming? 	$[level1/Astrid/l1_a_11]

$call PlayRadioAlert()
{@Monitor}	All CERES transmissions must comply with authorized protocols, or we’ll be forced to revoke your clearance. 	$[level1/monitor/l1_m_01]
{@Monitor}	Remember, communication is a privilege, not a right.	$[level1/monitor/l1_m_02]
{@Astrid}	Uhhh, who was that?	$[level1/Astrid/l1_a_12]
{@Dad}      Sorry, uh... “Station 12.” This channel doesn’t allow for... personal communications. 	$[level1/dad/l1_d_10]
{@Dad}      The Recovery Board is strict about research-only radio bands. 	$[level1/dad/l1_d_11]
{@Dad}      I’ll grant you entry-level access so you can help us. I should sign off now. More later.	$[level1/dad/l1_d_12]

$call SetInstrumentUnlocked(CoordinateInstrument, true)
$call SetInstrumentUnlocked(PhotometerInstrument, true)
$wait 1
{@Radio}	Station 12, this is CERES HQ. You have been granted entry level access.	$[level1/radio_lady/l1_r_04]
{@Radio}	Training begins immediately. Please follow all directives.	$[level1/radio_lady/l1_r_05]
{@Astrid}	Um, okay... Gosh, there are a lot of buttons here...	$[level1/Astrid/l1_a_13]

$set temp:fakeCutscene = false
$call MonitorUI->HideCERESLogo()
$call MonitorUI->PowerOn()
$call WaitForMovedToView("Monitor")

{@Radio}	I'll help you get up and running. Start by moving your telescope.	$[level1/radio_lady/l1_r_06]
$start .SetupTelescopeTutorial

// #endregion

// #region Neutrino Tutorial

:: SetupTelescopeTutorial
$call StartMonitorControls()
$call SetInputState(true)
$call TelescopeSetMoveEventActive(true)
$call HintModals->SlideInFromRight("TelescopeControls", 0.4)
$set temp:introMoveTheTelescope = false
$start .MoveTelescopeReminder

:: MoveTelescopeReminder
$wait 10
$if !temp:introMoveTheTelescope
    $call HintModals->Wiggle("TelescopeControls")
    {@Radio}	See if you can move your telescope.	$[level1/radio_lady/l1_r_07]
    $loop
$endif

:: MoveYourTelescope
@trigger    OnTelescopeMoved
@when   !temp:introMoveTheTelescope
@boostScore 100
@interrupt
@cutscene
@once

$call TelescopeSetMoveEventActive(false)
$set temp:introMoveTheTelescope = true
$call HintModals->Hide("TelescopeControls", 0.2)

{@Radio}	Your equipment seems to be working. Let’s test it out and look for the constellation Ursa Major. Sending coordinates now.	$[level1/radio_lady/l1_r_08]
$set temp:introMoveTheTelescope = true
$call MonitorUI->PlayRadioDownload(4.0)
{@Radio}	OK, looks like you received the coordinates. See those dots above your monitor? They will light up as you near the target.	$[level1/radio_lady/l1_r_09]
$branch .SetupNeutrinoNavigation

:: SetupNeutrinoNavigation
$call StartNeutrinoNavigation()
$call HintModals->SlideInFromLeft("NeutrinoNav", 0.4)

:: HotColdEncouragement1
@trigger    OnNeutrinoNavWarmer
@when   newPips == 1
@once

{@Radio}	Nice. Getting warmer.	$[level1/radio_lady/l1_r_10a]

:: HotColdEncouragement2
@trigger    OnNeutrinoNavWarmer
@when   newPips == 2
@once

{@Radio} Nice. Warmer... $[level1/radio_lady/l1_r_10b]

:: Colder
@trigger    OnNeutrinoNavColder
@when   newPips == 0

{@Radio} Colder. $[level1/radio_lady/l1_r_11a]

:: Colder2
@trigger    OnNeutrinoNavColder
@when   newPips == 1

{@Radio} Colder. $[level1/radio_lady/l1_r_11b]

:: Colder3
@trigger    OnNeutrinoNavColder
@when   newPips == 3

{@Radio} Colder. $[level1/radio_lady/l1_r_11c]

:: NeutrinoNavigationComplete
@trigger    NeutrinoNavigationComplete
@boostScore 100
@cutscene
@once
@interrupt

$call StopNeutrinoNavigation()
$call SetInputState(false)
$call AlignCamToNeutrino()
$call HintModals->Hide("NeutrinoNav", 0.2)
$call SetInputState(false)
$call StartOpenMode()
$set temp:introMoveTheTelescope = true
$set temp:upgradeChannelTuned = false
$call SetStickyFirstPage(0)
$call SetRefGuidePagesLocked(false)

{@Radio} Nice job! $[level1/radio_lady/l1_r_12]
{@Radio} So, earlier this morning, the IceCube Neutrino Observatory detected a high-energy neutrino coming from one of several possible stars in this location. $[level1/radio_lady/l1_r_13]
{@Radio} You should see these stars highlighted on your display. $[level1/radio_lady/l1_r_14]
{@Radio} You can learn more about the IceCube project in your reference guide. 	$[level1/radio_lady/l1_r_16]
{@Radio} If you can ID them for us, we should be able to upgrade your access level.	$[level1/radio_lady/l1_r_17]
{@Radio} To get started, select a possible neutrino source on your display.	$[level1/radio_lady/l1_r_18]
$goto .PostNeutrinoNavigationComplete

:: PostNeutrinoNavigationComplete
$set temp:waitingForNeutrinoStar = true

$call HintModals->SlideInFromLeft("SelectStar", 0.4)
$call SetInputState(true)
$start .FirstStarHint

:: FirstStarHint
$wait 12
$if temp:waitingForNeutrinoStar
    {@Radio} Astrid, you still there? Select a possible neutrino source on your display. $[level1/radio_lady/l1_r_19]
    $loop
$endif

:: OnStarSelected
@trigger    OnStarSelected
@when   temp:waitingForNeutrinoStar
@cutscene
@interrupt

$call ClearMonitorSelection()
{@Radio} Hmmm. That doesn't look a possible neutrino source. Look for objects highlighted in blue. $[level1/radio_lady/l1_r_20]

:: OnRefGuideClosed
@trigger    OnRefGuideClosed
@boostScore 300
@interrupt

$set temp:guideOpen = false

:: IntroRefGuideOpened
@trigger    OnRefGuideOpened
@when   temp:waitingForManualOpen
@boostScore 300
@interrupt
@cutscene
@once

$set temp:waitingForNeutrinoStar = false
$set temp:waitingForManualOpen = false
$call MoveToView("Right")
$call SetGuideHighlight(false)
$set temp:firstSubmission = false

{@Astrid} Got it. $[level1/Astrid/l1_a_14]
{@Radio} Okay. Do you see the photometer in your equipment stack? That should tell you the apparent magnitude of the star. 	$[level1/radio_lady/l1_r_24]
{@Radio} All you need to do is match that number with the correct range in your reference guide and submit the data.	$[level1/radio_lady/l1_r_25]
$call SetChannelActive(IceCube, false)
{@Radio} Another coalition astronomer will verify your classification.	$[level1/radio_lady/l1_r_26]
$start .IntroFirstSubmissionTimeout

:: IntroFirstSubmissionTimeout
@cutscene

$call SetInputState(true)
$wait 15

$if !temp:firstSubmission
    {@Radio} Okay. Do you see the photometer in your equipment stack? That should tell you the apparent magnitude of the star. 	$[level1/radio_lady/l1_r_24(1)]
    {@Radio} All you need to do is match that number with the correct range in your reference guide and submit the data.	$[level1/radio_lady/l1_r_25(1)]
    $call HintModals->SlideInFromRight("SubmitRangeHint", 0.2)
    $set temp:waitingForFirstClassificationClick = true

    $loop
$endif

:: OnRefGuideOpened
@trigger    OnRefGuideOpened
@interrupt

$set temp:guideOpen = true

:: OnNeutrinoStarSelected
@trigger    OnNeutrinoStarSelected
@when   temp:waitingForNeutrinoStar
@boostScore 100
@interrupt
@cutscene
@once

$call SubtitleController->SetSubtitlePosition(0.5, 0, 0, 650)
$set temp:waitingForNeutrinoStar = false
$set temp:waitingForManualOpen = true
$start Observatory.AnchorNextSubtitleToTop

$call HintModals->Hide("SelectStar", 0.2)

$if temp:guideOpen
    $goto .IntroRefGuideOpened
$endif

$call LockMonitorFocus()
$call SetGuideHighlight(true)

{@Radio} Great! Now see if you can find Elijah’s operator manual. It's a small, spiral bound notebook.	$[level1/radio_lady/l1_r_22]
$start .OpenManualHint

:: OpenManualHint
$wait 10
$if temp:waitingForManualOpen
    {@Radio} Have you found Elijah's operator manual? $[level1/radio_lady/l1_r_23]
    $loop
$endif

:: PlayerLeavesNeutrinoTask2
@trigger    OnLeaveNeutrinoRegion
@when   IsRadioFrequencyAt(137)
@once

{@Radio} Looks like you’re drifting away from the cluster. $[level1/radio_lady/l1_r_29]

:: PlayerLeavesNeutrinoTask
@trigger    OnLeaveNeutrinoRegion
@when   IsRadioFrequencyAt(137)

{@Radio} You are headed off target. $[level1/radio_lady/l1_r_28]

:: FirstClassificationClicked
@trigger    OnClassificationClicked
@when       temp:waitingForFirstClassificationClick == true

$call HintModals->Hide("SubmitRangeHint", 0.2)
$set temp:waitingForFirstClassificationClick = false

:: ValidKnowledgeSubmission
@trigger    OnValidKnowledgeSubmission
@when   IsRadioFrequencyAt(137)
@cutscene
@interrupt

$if temp:waitingForFirstClassificationClick
    $call HintModals->Hide("SubmitRangeHint", 0.2)
    $set temp:waitingForFirstClassificationClick = false
$endif

{@Radio} Thanks for adding that data. Please return to the neutrino zone. $[Radio/L1/l1_r_35]

:: IncorrectSubmission
@trigger    OnIncorrectOpenIdSubmission
@when   IsRadioFrequencyAt(137)

$if temp:waitingForFirstClassificationClick
    $call HintModals->Hide("SubmitRangeHint", 0.2)
    $set temp:waitingForFirstClassificationClick = false
$endif

$call SubtitleController->SetSubtitlePosition(0.5, 1, 0, -140)
$wait 0.1

{@Radio} Hmm, that wasn’t correct. Remember to look at your photometer, and then line it up with the correct range in your manual. $[level1/radio_lady/l1_r_27]
$start Observatory.ResetSubtitlePosition

:: FirstDupliacteSubmission
@trigger    OnDuplicateOpenIdSubmission
@when   IsRadioFrequencyAt(137)
@boostScore 100
@cutscene
@once

$if temp:waitingForFirstClassificationClick
    $call HintModals->Hide("SubmitRangeHint", 0.2)
    $set temp:waitingForFirstClassificationClick = false
$endif

{@Radio} Looks like you’ve already submitted that info. $[level1/radio_lady/l1_r_30]
{@Radio} You won’t get any points towards your access level for identifying that property again. $[level1/radio_lady/l1_r_31]

:: DupliacteSubmission
@trigger    OnDuplicateOpenIdSubmission
@interrupt

$if temp:waitingForFirstClassificationClick
    $call HintModals->Hide("SubmitRangeHint", 0.2)
    $set temp:waitingForFirstClassificationClick = false
$endif

{@Astrid} Looks like I have to determine the apparent magnitude of some of the other stars in this cluster. $[level1/Astrid/l1_a_16a]

:: FirstPoint
@trigger    PointsUpdated
@when   sciencePoints > 0
@interrupt
@boostScore 400
@cutscene
@once

$if temp:waitingForFirstClassificationClick
    $call HintModals->Hide("SubmitRangeHint", 0.2)
    $set temp:waitingForFirstClassificationClick = false
$endif

$call SubtitleController->SetSubtitlePosition(0.5, 0, 0, 40)
$set temp:firstSubmission = true
$call SetRadioDialLocked(false)

{@Astrid} Okay. That wasn't too bad. $[level1/Astrid/l1_a_15]
$call SetChannelActive(IceCube, true)
$start .PostPoint

:: IceCubeFirstPoint
@trigger    RadioChannelListenStart
@when       channelId == "IceCube", temp:introRadioChannelTuned, temp:firstSubmission
@priority   High
@boostScore 1000
@interrupt
@cutscene
@once

$call SetRadioDialLocked(true)
$call SetChannelActive(IceCube, false)
{@Radio} Nice job! See if you can determine the brightness for another star in the cluster.	$[level1/radio_lady/l1_r_32]
$start .PostPoint

:: SecondPoint
@trigger    PointsUpdated
@when   sciencePoints > 1
@interrupt
@cutscene
@once

{@Astrid} Nice! I'll try another one.	$[level1/Astrid/l1_a_16]
$start .PostPoint

:: PostPoint
$call SetRadioDialLocked(false)
$call UnlockMonitorFocus()

// #endregion

//#region Upgrade
:: ClearanceUpgrade
@trigger    PointsUpdated
@when   openIDThresholdHit
@boostScore 200
@interrupt
@cutscene
@once

$call SetInputState(false)
$call SetRefGuideActive(false)
$set temp:readyForUpgrade = true

$call MonitorUI->ShowElement("CeresMsg")
$call MonitorUI->ShowElement("UpgradeMsg")
$wait 1
$call StopOpenMode()
{@Astrid} Looks like CERES is trying to contact me. I wonder what that's about...	$[level1/Astrid/l1_a_17]
$call SetChannelActive(IceCube, true)

$call SetChannelActive(Unlocks_Active, true)
$call SetStickyFirstPage(7)
$call HintModals->SlideInFromRight("RadioControls", 0.4)
$call SetInputState(true)

:: IceCubeUpgradeReminder
@trigger    RadioChannelListenStart
@when       channelId == "IceCube", IsRadioFrequencyAt(137), temp:introRadioChannelTuned, !temp:upgradeChannelTuned, temp:readyForUpgrade
@priority   Medium
@boostScore 1000
@cutscene
@once

$call MonitorUI->HideElement("CeresMsg")
$call SetRadioDialLocked(true)
{@Radio} It looks like you’ve identified the necessary data to earn a higher access level. $[level1/radio_lady/l1_r_33]
{@Radio} You’ll need to tune to 375 megahertz on your radio so we can unlock your equipment. $[level1/radio_lady/l1_r_34]
$call SetRadioDialLocked(false)
$call SetChannelActive(IceCube, false)

:: ClearanceUpgradeTrigger
@trigger    RadioChannelListenStart
@when       channelId == "Unlocks_Active"
@interrupt
@cutscene
@once

$call MonitorUI->HideElement("CeresMsg")
$call MonitorUI->HideElement("UpgradeMsg")
$call HintModals->Hide("RadioControls", 0.2)

$set temp:upgradeChannelTuned = true
$call SetRadioDialLocked(true)
$call SetRadioFrequency(375, true)
$call SetInputState(false)
$call ClearMonitorSelection()
$call LockMonitorFocus()
$call MonitorUI->PlayRadioDownload(2)
$call ConsoleCommandLine->PlayConsoleTextAndWait("UpgradeSystem")
$call SetChannelActive(Unlocks_Active, false)
$call SetRadioFrequency(137)
$call MonitorUI->ShowCERESLogo()
$call MonitorUI->CERESLogoToCorner(0.5)
$wait 1
{@Astrid} Well, that was... something... $[level1/Astrid/l1_a_18]
$call SetInputState(true)

$call ConsoleCommandLine->PlayConsoleTextAndWait("Day1UpgradeSystem")
$wait 1
{@Astrid}	Starting at the bottom... clearance level one.	$[level1/Astrid/l1_a_19]
$wait 1

$call SetInstrumentUnlocked(ColorInstrument, true)
$call SetInstrumentUnlocked(TemperatureInstrument, true)
$call SetStickyFirstPage(-1)
$call OpenRefGuidePage("Colormeter")

$wait 1.5
{@Astrid} Clearance level 1... Color meter access granted. Please reference CERES Op. manual for more info. $[level1/Astrid/l1_a_20]
{@Astrid} Congratulations on reaching clearance Level 1. Together we will map the stars for a greater tomorrow... $[level1/Astrid/l1_a_20a]

$call ConsoleCommandLine->HideConsole()
$wait 0.1
$call MonitorUI->CERESLogoToCenter(0.5)
$wait 1
$call MonitorUI->HideCERESLogo()
$wait 0.5

$call SetRefGuideActive(false)

{@Astrid}	(*sigh*) Another birthday without Elijah. Maybe he’s watching the Perseids, wherever he is.	$[level1/Astrid/l1_a_21]
$wait 1.5
{@Astrid} I wonder if there's anything about the Perseids in that operator's manual. $[level1/Astrid/l1_a_22]

$call OpenRefGuidePage("ConstellationPerseus")

{@Astrid} Yes... There’s something about Perseus here! $[level1/Astrid/l1_a_23]
{@Astrid} Aha! $[level1/Astrid/l1_a_24]
{@Astrid} This time it's my turn to see Perseus through a telescope. $[level1/Astrid/l1_a_25]
$wait 1
$goto .PostClearanceUpgrade

:: PostClearanceUpgrade
$start Observatory.PathToMonitor
$call SetRefGuideActive(false)
$call ConsoleCommandLine->PlayConsoleTextAndWait("Day1ConsoleText")
$call ConsoleCommandLine->HideConsole()
$call SetInputState(true)
$start Observatory.AnchorNextSubtitleToTop
$call StartPuzzleNavigation()

:: HotColdEncouragement3
@trigger    OnConstellationNavWarmer
@when   newPips > 0
@once

{@Astrid}	Getting warmer...	$[level1/Astrid/l1_a_26]

:: HotColdEncouragement4
@trigger    OnConstellationNavWarmer
@when   newPips > 1
@once

{@Astrid}	Getting closer...	$[level1/Astrid/l1_a_27]

:: Colder4
@trigger    OnConstellationNavColder
@when   newPips < 1
@once

{@Astrid}	Oops, not over here...	$[level1/Astrid/l1_a_28]

:: Colder5
@trigger    OnConstellationNavColder
@when   newPips < 2
@once

{@Astrid}	Ach, colder!	$[level1/Astrid/l1_a_29]
// #endregion

// #region Puzzle Tutorial

:: PuzzleNavigationComplete
@trigger    PuzzleNavigationComplete
@priority   Low
@boostScore 100
@cutscene
@once

{@Astrid}	(*sigh*) Happy birthday to me.	$[level1/Astrid/l1_a_32]
$call StartPuzzleMode()
$call UnlockMonitorFocus()
$set temp:waitingForSelectAtik = true
$wait 0.3
{@Astrid}	Whoa... what's happening? Did I break something??	$[level1/Astrid/l1_a_33]

$wait 1
{@Astrid}	Overriding the CERES framework? 	$[level1/Astrid/l1_a_34]
$wait 2
{@Astrid}	Elijah must've set this up.	$[level1/Astrid/l1_a_35]
{@Astrid}	This looks like the data from that Perseus page!	$[level1/Astrid/l1_a_36]
{@Astrid}	Do I finally get to do some astronomy by myself? This is wild. 	$[level1/Astrid/l1_a_37]
{@Astrid}	I've been so busy helping Aunt Martha. I hope I remember how to do this. 	$[level1/Astrid/l1_a_38]
{@Astrid}	Okay, you got this Astrid. Start with what I know—the coordinates for Atik. 	$[level1/Astrid/l1_a_39]
$goto .PostPuzzleNavigationComplete

:: PostPuzzleNavigationComplete
$wait 0.5
$call SetRadioDialLocked(false)
$call HintModals->SlideInFromRight("FirstPuzzleStar", 0.4)
$call SubtitleController->SetSubtitlePosition(0.5, 0, 0, 40)
$branch .SelectAtikReminder

:: SelectAtikReminder
$wait 10
$if temp:waitingForSelectAtik
    {@Astrid}	It looks like the star compass gives me readings when I select a star on the monitor. That helps.	$[level1/Astrid/l1_a_40]
    $goto .SelectAtikReminder
$endif

:: OnRandomPuzzleStarSelected
@trigger OnStarSelected
@boostScore 150
@once

$set temp:waitingForSelectAtik = false

:: FirstPuzzleStarSelected
@trigger   OnStarSelected
@when   starName == "Atik", temp:waitingForSelectAtik
@boostScore 200
@interrupt
@cutscene
@once

$call SubtitleController->SetSubtitlePosition(0.5, 1, 0, -140)
$call LockMonitorFocus()
$set temp:waitingForSelectAppMag = true
$set temp:waitingForSelectAtik = false
$call HintModals->CloseAllModals()
$call IsolatePuzzleCell(1, 3)

{@Astrid}	Yes! Now I can use my photometer to fill in the apparent magnitude for Atik.	$[level1/Astrid/l1_a_41]
{@Astrid}	I think can enter the apparent magnitude for Atik in the puzzle cell beneath the monitor.	$[level1/Astrid/l1_a_42]
$goto .PostFirstPuzzleStarSelected

:: PostFirstPuzzleStarSelected
$start Observatory.ResetSubtitlePosition
$call HintModals->SlideInFromRight("AtikCell", 0.4)

:: NotAtikAstrid
@trigger    OnPuzzleCellSelected
@when   cellId != "R1C3", temp:waitingForSelectAppMag
@cooldown 10

{@Astrid}	I need to select the apparent magnitude space for Atik on this grid...	$[level1/Astrid/l1_a_43]

:: NotPuzzleCellAstrid
@trigger    OnLabInteraction
@when   cellId != "R1C3", actorId != "PhotometerLoadBtn", temp:waitingForSelectAppMag
@cooldown 10

$call HintModals->Wiggle("AtikCell")
{@Astrid}	I think can enter the apparent magnitude for Atik in the puzzle cell beneath the monitor.	$[level1/Astrid/l1_a_42(1)]

:: AtikAppMagSelected
@trigger    OnPuzzleCellSelected
@when   cellId == "R1C3", temp:waitingForSelectAppMag
@interrupt
@cutscene

$set temp:waitingForFillAppMag = true
$call AddIsolatedSlot(ApparentMagnitude)
$call HintModals->Hide("AtikCell", 0.2)

{@Astrid}	Now all I have to do is load in data from the photometer.	$[level1/Astrid/l1_a_44]

:: AtikAppMagInstrumentSelected
@trigger    OnLabInteraction
@when   actorId == "PhotometerLoadBtn", temp:waitingForSelectAppMag
@interrupt
@cutscene

$set temp:waitingForFillAppMag = true
$call AddIsolatedSlot(ApparentMagnitude)
$call HintModals->Hide("AtikCell", 0.2)

{@Astrid}	I need to select the apparent magnitude space for Atik on this grid...	$[level1/Astrid/l1_a_43(1)]

:: AstridThatsNotThePhotometer
@trigger    OnLabInteraction

@when   actorId != "PhotometerLoadBtn", actorId != "R1C3", temp:waitingForFillAppMag
@interrupt
@cutscene
@cooldown 10

{@Astrid}	Hmm, that’s not the photometer. 	$[level1/Astrid/l1_a_45]

:: AtikAppMagFilled
@trigger    OnPuzzleCellFilled
@when   cellId == "R1C3", temp:waitingForFillAppMag
@priority Medium
@boostScore 300
@interrupt
@cutscene
@once

$set temp:waitingForSelectAppMag = false
$set temp:waitingForFillAppMag = false
$set temp:waitingForBlueFilter = true
$call ReleaseIsolatedPuzzle()
$call SetInstrumentUnlocked(VisibleWavelength, true)
$call SetInstrumentUnlocked(BlueWavelength, true)
$call IsolatePuzzleCell(1, 1)
{@Astrid}	Let's see... to fill in the rest of this sequence, I also need the Blue magnitude. 	$[level1/Astrid/l1_a_46]
{@Astrid}	I need to select the blue wavelength filter just below the monitor.	$[level1/Astrid/l1_a_47]
$call HintModals->SlideInFromLeft("BlueFilter", 0.4)
$goto .PostAtikAppMagFilled

:: PostAtikAppMagFilled
$call Wait(1)

:: BlueFilterSelected
@trigger    OnLabInteraction
@when   actorId == "BlueFilter", temp:waitingForBlueFilter
@boostScore 300
@interrupt
@cutscene

$set temp:waitingForBlueFilter = false
$set temp:waitingForBlueLight = true
$call HintModals->Hide("BlueFilter", 0.2)
$call ReleaseIsolatedPuzzle()
$call IsolatePuzzleCell(1, 4)

{@Astrid}	Ok, with the blue filter on, my photometer has a new reading!	$[level1/Astrid/l1_a_49]
{@Astrid}	Now I can load this data into the blue magnitude space with my photometer just like before. 	$[level1/Astrid/l1_a_50]

:: AtikNotBlueFilterSelected
@trigger    OnLabInteraction
@when   actorId != "BlueFilter", cellId != "R1C4", temp:waitingForBlueFilter
@interrupt
@cutscene
@cooldown 10

{@Astrid}	The Blue wavelength filter is there on the monitor.	$[level1/Astrid/l1_a_48]

:: NotBlueLightAstrid
@trigger OnPuzzleCellSelected
@when   cellId != "R1C4", actorId != "PhotometerLoadBtn", temp:waitingForBlueLight
@interrupt
@cutscene

$if !temp:AtikCell2Hint
    $call ReleaseIsolatedPuzzle()
    $call IsolatePuzzleCell(1, 4)
    $call HintModals->SlideInFromRight("AtikCell2", 0.4)
    $set temp:AtikCell2Hint = true
$endif
{@Astrid}	I'm looking for the blue magnitude cell on the grid. It should be next to that data I just entered. $[level1/Astrid/l1_a_51]

:: BlueLightCellSelected
@trigger    OnPuzzleCellSelected
@when   cellId == "R1C4", temp:waitingForBlueLight
@interrupt
@cutscene

$call AddIsolatedSlot(BlueMagnitude)
$call HintModals->CloseAllModals()

{@Astrid}	Now I can load this data into the blue magnitude space with my photometer just like before. 	$[level1/Astrid/l1_a_50]

:: BlueLightInstrumentSelected
@trigger    OnLabInteraction
@when   actorId = "PhotometerLoadBtn", temp:waitingForBlueLight
@interrupt
@cutscene

$call AddIsolatedSlot(BlueMagnitude)
$call HintModals->CloseAllModals()

{@Astrid}	I'm looking for the blue magnitude cell on the grid. It should be next to that data I just entered. $[level1/Astrid/l1_a_51]

:: AtikBlueMagFilled
@trigger    OnPuzzleCellFilled
@when   cellId == "R1C4", temp:waitingForBlueLight
@interrupt
@cutscene
@once

$call ReleaseIsolatedPuzzle()
$set temp:waitingForBlueLight = false
$set temp:waitingForFillColor = true
$call SetInputState(false)
{@Astrid}	I've got the apparent magnitude and the blue magnitude... so now I can calculate the <b>color index</b>!	$[level1/Astrid/l1_a_52]

$call IsolatePuzzleCell(1, 2)
$call SetInputState(true)

{@Astrid}	The hotter the star, the bluer it is. Now I can load the color of the star... and put it in the color space for Atik	$[level1/Astrid/l1_a_53]

:: AtikColorCellSelected
@trigger    OnPuzzleCellSelected
@when   cellId == "R1C2", temp:waitingForFillColor
@priority   Medium
@boostScore 100
@interrupt
@cutscene

$call AddIsolatedSlot(Color)
{@Astrid}	Alright, now I should load the calculated color index.	$[level1/Astrid/l1_a_55]

:: AtikColorInstrumentSelected
@trigger    OnLabInteraction
@when   actorId == "ColorIndexLoadBtn", temp:waitingForFillColor
@priority   Medium
@boostScore 100
@interrupt
@cutscene

$call AddIsolatedSlot(Color)
{@Astrid}	Now I can load this data into the last empty cell in the second row.	$[level1/Astrid/l1_a_56]

:: WhereIsTheColorIndexer
@trigger    OnLabInteraction
@when   temp:waitingForFillColor, actorId != "ColorIndexLoadBtn"
@interrupt
@cutscene
@cooldown 10

{@Astrid}	Where was the color index... oh yeah, to the right of the photometer.	$[level1/Astrid/l1_a_54]

:: AtikColorFilled
@trigger    OnPuzzleRowFilled
@when   rowId == 1, temp:waitingForFillColor
@priority   High
@boostScore 400
@interrupt
@cutscene
@once

$call SetInputState(false)
$set temp:waitingForFillColor = false
$set temp:AtikRowFilled = true
$call ReleaseIsolatedPuzzle()
$call SubtitleController->SetSubtitlePosition(0.5, 0, 0, 40)

{@Astrid}	Okay, now it’s just process of elimination. I’m pretty sure Atik is the star on the second row of this grid.	$[level1/Astrid/l1_a_57]
$goto .HintForSecondRow

:: HintForSecondRow
$set temp:AlgolRowFilled = false
$set temp:waitingForSelectAlgol = true
$call HintModals->SlideInFromRight("BrightestBlue", 0.4)
$call UnlockMonitorFocus()
$call SetInputState(true)

{@Astrid}	What else do the clues on the monitor say? Apparently Algol is the brightest star in Blue?	$[level1/Astrid/l1_a_58]
{@Astrid}	Which of these stars is the brightest in blue?	$[level1/Astrid/l1_a_59]

:: SecondPuzzleStarSelected
@trigger   OnStarSelected
@when   starName == "Algol", !temp:AlgolRowFilled, temp:AtikRowFilled
@boostScore 100
@interrupt
@cutscene

{@Astrid}	Is this the brightest star in the blue filter? That would make this Algol.	$[level1/Astrid/l1_a_61]
{@Astrid}	If this is Algol, then I should load this star's data into the first row.	$[level1/Astrid/l1_a_62]

$branch .PostSecondPuzzleStarSelected

:: PostSecondPuzzleStarSelected
$call UnlockMonitorFocus()

:: NotSecondPuzzleStarSelected
@trigger   OnStarSelected
@when   starName != "Algol", !temp:AlgolRowFilled, temp:AtikRowFilled
@interrupt
@cutscene
@cooldown 15

{@Astrid}	I should compare the blue magnitude of this star to the others in the cluster.	$[level1/Astrid/l1_a_60]

:: AtikSelectedPostFilled
@trigger   OnStarSelected
@when   starName == "Atik", temp:AtikRowFilled, temp:AtikRowFilled
@boostScore 100
@interrupt
@cutscene
@cooldown 15

{@Astrid}	I’ve already submitted the data for this star.	$[level1/Astrid/l1_a_68]
{@Astrid}	I think this is the second one... <i>Atik</i>.	$[level1/Astrid/l1_a_70]

$if !temp:readyToSubmit, temp:AlgolRowFilled
    $branch .PuzzleTimeoutHint
$endif

:: AlgolSelectedPostComplete
@trigger   OnStarSelected
@when   starName == "Algol", temp:CompletedAlgolRow, temp:AtikRowFilled
@boostScore 100
@interrupt
@cutscene

{@Astrid}	I’ve already submitted the data for this star.	$[level1/Astrid/l1_a_68]
{@Astrid}	I think this is the first star on my grid... <i>Algol</i>.	$[level1/Astrid/l1_a_69]

:: MenkibSelectedPostComplete
@trigger   OnStarSelected
@when   starName == "Menkib", temp:CompletedMenkibRow, temp:AtikRowFilled
@boostScore 100
@interrupt
@cutscene

{@Astrid}	I’ve already submitted the data for this star.	$[level1/Astrid/l1_a_68]
{@Astrid}	This should be <i>Menkib</i>.	$[level1/Astrid/l1_a_71]

:: MirfakSelectedPostComplete
@trigger   OnStarSelected
@when   starName == "Mirfak", temp:CompletedMirfakRow, temp:AtikRowFilled
@boostScore 100
@interrupt
@cutscene

{@Astrid}	I’ve already submitted the data for this star.	$[level1/Astrid/l1_a_68]
{@Astrid}	I think this one is <i>Mirfak</i>.	$[level1/Astrid/l1_a_72]

:: AlgolDataFilled
@trigger    OnPuzzleRowFilled
@when   rowId == 0, temp:AtikRowFilled
@boostScore 1000
@priority High
@interrupt
@cutscene
@once

$set temp:AlgolRowFilled = true
$if temp:MirfakRowFilled, temp:MenkibRowFilled
    $goto .PuzzleGridReadyForSubmissionFirstTime
$endif
$call HintModals->CloseAllModals()
$call UnlockMonitorFocus()
$set temp:readyToSubmit = false

{@Astrid}	Okay, I’ve eliminated two rows of the grid. That just leaves two stars to go. 	$[level1/Astrid/l1_a_63]
{@Astrid}	I can use the clues on the monitor to figure out which star is Menkib and which is Mirfak.	$[level1/Astrid/l1_a_64]
$branch .PostAlgolDataFilled

::PostAlgolDataFilled
$call UnlockMonitorFocus()
$call HintModals->SlideInFromRight("ElijahPuzzle", 0.4)
$branch .PuzzleTimeoutHint

:: AlgolDataFilled2
@trigger    OnPuzzleRowFilled
@when   rowId == 0, temp:AtikRowFilled
@interrupt
@cutscene

$set temp:AlgolRowFilled = true
$call HintModals->CloseAllModals()
$call UnlockMonitorFocus()
$call HintModals->SlideInFromRight("ElijahPuzzle", 0.4)
$branch .PuzzleTimeoutHint

:: PuzzleTimeoutHint
$wait 30
$if !temp:readyToSubmit, !temp:MenkibRowFilled
    {@Astrid}	Let’s see. I know Menkib is NOT the brightest in visible. Which of my remaining stars does that match?	$[level1/Astrid/l1_a_73]
    $loop
$elseif !temp:readyToSubmit, !temp:MirfakRowFilled
    {@Astrid}	Let’s see. I know Mirfak is cooler than Atik. And the hotter the star, the bluer it is—just like a flame.	$[level1/Astrid/l1_a_74]
    {@Astrid}	I should check if either of these stars are colder than the star in row two.	$[level1/Astrid/l1_a_75]
    $loop
$endif

:: MirfakDataFilled
@trigger    OnPuzzleRowFilled
@when   rowId == 3
@interrupt

$set temp:MirfakRowFilled = true

:: MenkibDataFilled
@trigger    OnPuzzleRowFilled
@when   rowId == 2
@interrupt

$set temp:MenkibRowFilled = true

:: PuzzleGridReadyForSubmission
@trigger    OnPuzzleGridFullyPopulated
@interrupt

$call HintModals->CloseAllModals()

:: PuzzleGridReadyForSubmissionFirstTime
@trigger    OnPuzzleGridFullyPopulated
@interrupt
@cutscene
@boostScore 2000
@once

$call HintModals->CloseAllModals()

$set temp:CompletedMenkibRow = false
$set temp:CompletedAlgolRow = false
$set temp:CompletedMirfakbRow = false
{@Astrid}	That’s all the data… (*deep breath*) Here goes nothing!	$[level1/Astrid/l1_a_65]

:: IncorrectPuzzleSubmission
@trigger    IncorrectPuzzleSubmission
@interrupt
@cutscene

$set temp:readyToSubmit = false
$if !local:row_1
    $set temp:AtikRowFilled = false
$endif
$if !local:row_2
    $set temp:MenkibRowFilled = false
$else
    $set temp:CompletedMenkibRow = true
$endif
$if !local:row_3
    $set temp:MirfakRowFilled = false
$else
    $set temp:CompletedMirfakRow = true
$endif

{@Astrid}	Ugh. That's not right. What did I miss? 	$[level1/Astrid/l1_a_66]
$if !local:row_0
    $set temp:AlgolRowFilled = false
    $goto .HintForSecondRow
$else
    $set temp:CompletedAlgolRow = true
    $branch .PuzzleTimeoutHint
$endif

// #endregion

:: PerseusPuzzleComplete
@trigger    CorrectPuzzleSubmission
@when   puzzleName == "Perseus"
@cutscene
@interrupt
@once

{@Astrid}	Yes!! I got it!	$[level1/Astrid/l1_a_76]
$call StopPuzzleMode()
$call SetInputState(false)
$call ConsoleCommandLine->PlayConsoleTextAndWait("PlayMessage")
$call SetRefPageActive("ConstellationPerseus", false)
$call SetRefPageActive("ConstellationPerseusCompleted", true)
$call OpenRefGuidePage("ConstellationPerseusCompleted")
$call ClearMonitorSelection()

$call TapeDeck->SetTapeActive(true)
{@Elijah}	Check, check? Alright, this is recording. 	$[level1/Elijah/l1_e_01]
{@Astrid}	Elijah! 	$[level1/Astrid/l1_a_77]
{@Elijah}	Astrid. If you're hearing this, you solved the first puzzle. One down, four to go. 	$[level1/Elijah/l1_e_02]
{@Elijah}	Part of me wants to tell you to keep working. If anyone can solve those puzzles, you can. 	$[level1/Elijah/l1_e_03]
{@Elijah}	But that's pretty messed up of me to ask. I was supposed to be there to meet you. We were supposed to do this together. 	$[level1/Elijah/l1_e_04]
{@Astrid}	Do what together?	$[level1/Astrid/l1_a_78]
{@Elijah}	I've been thinking about that Shakespeare quote. "...thou, residing here, go'st yet with me,   And I, hence fleeting, here remain with thee.” I'm with you there... in spirit.	$[level1/Elijah/l1_e_05]
{@Astrid}	Dude. I wish.	$[level1/Astrid/l1_a_79]
{@Elijah}	I hope you can understand. Love you, Astrid. 	$[level1/Elijah/l1_e_06]
$call ConsoleCommandLine->HideConsole()
$call TapeDeck->SetTapeActive(false)
{@Astrid}	Ugh. What will all be worth it? 	$[level1/Astrid/l1_a_80]
{@Astrid}	I don't get it. It looks like there's more tape... why can't I play the rest of the message?	$[level1/Astrid/l1_a_81]

$call SetRefGuideActive(false)
$wait 0.5

$call MonitorUI->ShowElement("CeresMsg")
$wait 1
$call SetRadioFrequency(137)
$call SetRadioDialLocked(true)
$call MonitorUI->HideElement("CeresMsg")
$wait 1

{@Dad}	CERES HQ checking in. Great work today!	$[level1/dad/l1_d_13]
{@Dad}	It’s late where you are. Get some rest. I sent you a letter. You should get it in a few weeks.	$[level1/dad/l1_d_14]
{@Astrid}	(*yawns*) Ok. I’ll be looking out for it. Can I say I miss you on here?	$[level1/Astrid/l1_a_82]
$wait 1

$call EndDay2->BeginCutscene()
$wait 1
{@Astrid}	Oh, Elijah... What are you getting yourself into?	$[level1/Astrid/l1_a_83]
$wait 1

:: EndDay
@trigger    CutsceneEnd
@when cutsceneId == "EndDay2"

$call StopMusic(1)
$call LoadNextDay()