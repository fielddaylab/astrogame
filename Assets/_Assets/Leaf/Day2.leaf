#basePath	Day2

// #region Preload

:: Preload
@function   ScenePreload
$call InitUpdateMasks()
$call ToggleDeskPicture()
$call EnableDocumentClose("HerculesPostcard", false)
$call EnableDocumentClose("Day2DadIcecubePostcard", false)
$call EnableDocumentClose("1833", false)
$call SetInstrumentUnlocked(CoordinateInstrument, true)
$call SetInstrumentUnlocked(PhotometerInstrument, true)
$call SetInstrumentUnlocked(VisibleWavelength, true)
$call SetInstrumentUnlocked(BlueWavelength, true)
$call SetInstrumentUnlocked(ColorInstrument, true)
$call SetInstrumentUnlocked(TemperatureInstrument, true)
$call SpawnDocument("Day2Cal")
$call SpawnDocument("MarthaGuilt")
$call SpawnDocument("ElijahHike")
$call SpawnDocument("Cutoff")
$call SpawnDocument("Level1")
$call SpawnDocument("MiniLabors")
$call StopPuzzleMode()
$call StopOpenMode()
$call SetRefGuidePagesLocked(true)
$call SetRefPageActive("ConstellationPerseus", false)
$call SetRefPageActive("ConstellationHerculesCompleted", false)
$call SetRefPageActive("ConstellationLeoCompleted", false)
$call SetRefPageActive("ConstellationDracoCompleted", false)
$call SetRefPageActive("ConstellationAndromedaCompleted", false)
$call SetChannelActive(Unlocks_Active, false)
$call SetChannelActive(IceCube, false)
$call SetRadioFrequency(137, true)
$call MonitorPower->Deactivate()
$call ChapterTitles->PrepareTransition()
$call SubtitleController->SetSubtitlePosition(0.5, 0, 0, 40)
$call SetRadioDialLocked(true)

$call PreloadMusic("Music.StarlightStudent")

// #endregion

//#region Spawn Documents

:: BeginDay
@trigger    SceneReady
@boostScore 100
@cutscene

$call ChapterTitles->DisplayChapterTitles()
$call SetInputState(false)
$call WaitForMovedToView("DocumentPuzzle")
$call ChapterTitles->FadeOutBackground()
$call ChapterTitles->FinishTransition(3)
$call PlayMusic("Music.StarlightStudent", 3)

{@Astrid} Yes! Finally, some mail. 	$[level2/Astrid/l2_a_01]
{@Astrid} So glad the post is working again... even if it does take forever to show up. 	$[level2/Astrid/l2_a_02]
{@Astrid} Never woulda thought I'd miss e-mail...	$[level2/Astrid/l2_a_02b]

$call SetInputState(true)

$call SpawnDocumentToCamera("Day2DadIcecubePostcard")

{@Astrid}	Wow, that's Dad at IceCube!	$[level2/Astrid/l2_a_03]

:: FlipDadPostcard
@trigger    DocumentInspectFlip
@when   documentId == "Day2DadIcecubePostcard"
@interrupt
@cutscene
@once

$call EnableDocumentClose("Day2DadIcecubePostcard", true, true)
$wait 1
{@Astrid}	I wonder if he ever feels weird about the southern lights, after everything that happened.	$[level2/Astrid/l2_a_04]
{@Astrid}	I guess auroras don't usually come with a huge <b>coronal mass ejection</b>... but I think it might still freak me out. $[level2/Astrid/l2_a_05]

:: SpawnPuzzleDocs1
@trigger    DocumentInspectEnd
@when   documentId == "Day2DadIcecubePostcard"
@cutscene
@interrupt
@once

$call SetInputState(false)
$wait 1
$call SpawnDocumentToCamera("HerculesPostcard")
$call SetInputState(true)
{@Astrid}	Elijah! Wow, this is cool. I guess he brought his art supplies with him. 	$[level2/Astrid/l2_a_06]
{@Astrid}	Looks like the Hercules constellation. 	$[level2/Astrid/l2_a_07]

:: FlipHercules
@trigger    DocumentInspectFlip
@when   documentId == "HerculesPostcard"
@interrupt
@cutscene
@once

$call EnableDocumentClose("HerculesPostcard", true, true)
$wait 1

{@Astrid}	What? We're running out of time? What does that mean? 	$[level2/Astrid/l2_a_08]
{@Astrid}	And why are you talking about the end of the world? 	$[level2/Astrid/l2_a_09]
{@Astrid}	Elijah, I love you, but you're sort of freaking me out.	$[level2/Astrid/l2_a_10]

:: SpawnPuzzleDocs2
@trigger    DocumentInspectEnd
@when   documentId == "HerculesPostcard"
@interrupt
@boostScore 100
@cutscene
@once

$call SetInputState(false)
$wait 1
$call SpawnDocumentToCamera("Day2Martha")
$call SetInputState(true)

{@Astrid}	I feel so guilty for leaving Aunt Martha to run the clinic by herself.	$[level2/Astrid/l2_a_11]
{@Astrid}	But I can't go home yet. I finally get to do some real astronomy here. And what if Elijah comes back? 	$[level2/Astrid/l2_a_12]

:: SpawnPuzzleDocs3
@trigger    DocumentInspectEnd
@when   documentId == "Day2Martha"
@interrupt
@boostScore 100
@cutscene
@once

$call SetInputState(false)
$wait 1
$set temp:puzzleComplete = false
{@Astrid}	I still have so many questions.	$[level2/Astrid/l2_a_14]
$wait 0.5

$call SpawnDocumentToCamera("Day2Question")
$call StartDocumentPuzzle("Day2DocumentPuzzle")
$set temp:docPuzzleSolved = false
$call SetInputState(true)

{@Astrid}	Where is Elijah? Is he okay? 	$[level2/Astrid/l2_a_15]

// #endregion 

//#region Document Puzzle

:: InspectMiniMap
@trigger    DocumentInspectStart
@when   documentId == "MiniLabors"
@cutscene
@once

{@Astrid}	Hmm... The 12 labors. Elijah mentioned that in his postcard. 	$[level2/Astrid/l2_a_20]

:: InspectRadioPostit
@trigger    DocumentInspectStart
@when   documentId == "Cutoff"
@cutscene
@once

{@Astrid}	This little radio is my only connection to the rest of the world right now. 	$[level2/Astrid/l2_a_13a]

:: InspectMarthaGuilt
@trigger    DocumentInspectStart
@when   documentId == "MarthaGuilt"
@cutscene
@once

{@Astrid}	I hope the clinic is still going well... 	$[level2/Astrid/l2_a_13b]

:: InspectElijahHike
@trigger    DocumentInspectStart
@when   documentId == "ElijahHike"
@cutscene
@once

{@Astrid}	I wonder where he is right now. 	$[level2/Astrid/l2_a_13c]

:: InspectDay2Cal
@trigger    DocumentInspectStart
@when   documentId == "Day2Cal"
@cutscene
@once

{@Astrid}	I've been here for two weeks already!	$[level2/Astrid/l2_a_13d]

:: InspectLevel1
@trigger    DocumentInspectStart
@when   documentId == "Level1"
@cutscene
@once

{@Astrid} Clearance Level 1! I'm a certified "junior astronomer." $[level2/Astrid/l2_a_13e]

:: Day2Question2DocumentInspectEnd
@trigger    DocumentInspectEnd
@when   documentId == "Day2Question"
@once

$call HintModals->SlideInFromLeft("DocOnboard", 0.4)
$set temp:DocOnboardHintVisible = true

:: IncorrectDocumentResponse1
@trigger    DocumentPuzzlePromptStart
@when   answerId == "Day2DadIcecubePostcard", !temp:docPuzzleSolved

{@Astrid} Elijah in Antarctica? Somehow I feel like Dad would've mentioned that... $[level2/Astrid/l2_a_18]

:: IncorrectDocumentResponse2
@trigger    DocumentPuzzlePromptStart
@when   answerId == "Day2Martha", !temp:docPuzzleSolved

{@Astrid} Could he be working at Aunt Martha's clinic? No way... they'd drive each other crazy. $[level2/Astrid/l2_a_16]

:: IncorrectDocumentResponse3
@trigger    DocumentPuzzlePromptStart
@when   answerId == "MarthaGuilt", !temp:docPuzzleSolved

{@Astrid}	I drew this. It won't help answer my question though.	$[level1/Astrid/l1_a_g3]

:: IncorrectDocumentResponse4
@trigger    DocumentPuzzlePromptStart
@when   answerId == "HerculesPostcard", !temp:docPuzzleSolved

{@Astrid} Elijah says he's getting all the observatories ready for... something. $[level2/Astrid/l2_a_17]

:: CorrectDocumentResponse
@trigger    DocumentPuzzlePromptStart
@when   answerId == "MiniLabors", questionId == "Day2Question", !temp:docPuzzleSolved
@interrupt
@boostScore 1000
@cutscene
@once

$call SetInputState(false)
$if temp:DocOnboardHintVisible
    $call HintModals->Hide("DocOnboard", 0.2)
    $set temp:DocOnboardHintVisible = false
$endif

{@Astrid} The 12 Labors of Hercules... 12 CERES stations... maybe this is a map of where he went! $[level2/Astrid/l2_a_13]
{@Astrid} That's it! Elijah is traveling to the CERES stations. He's getting them ready for... something. $[level2/Astrid/l2_a_19]
$start .CorrectDocumentResponseSolved

:: CorrectDocumentResponseSolved
@cutscene

$set temp:docPuzzleSolved = true
$call SetInputState(true)
$wait 1

$if !temp:puzzleComplete
    $set temp:puzzleComplete = true
    $call MoveToView("Desk")
    $wait 1
    $goto .StartNeutrinoNav
$endif
// #endregion

//#region Open Identification
:: StartNeutrinoNav
@cutscene

$call SetChannelActive(IceCube, true)
$call WaitForMovedToView("Right")
{@Radio} CERES HQ to Station 12. $[level2/radio_lady/l2_r_01]
{@Radio} IceCube is detecting a high-energy neutrino emission from the area of the Hydra Constellation. $[level2/radio_lady/l2_r_02]
$call SetInputState(true)
{@Radio} Uploading area of interest. $[level2/radio_lady/l2_r_03]
$goto .SetupNeutrinoNav

:: SetupNeutrinoNav
$call StartMonitorControls()
$call WaitForMovedToView("Monitor")
$call MonitorUI->PlayRadioDownload(4)
$call StartNeutrinoNavigation()

:: NeutrinoNavigationComplete
@trigger    NeutrinoNavigationComplete
@cutscene
@once

$call StopNeutrinoNavigation()
$call SetInputState(false)
$call AlignCamToNeutrino()
$call SetInputState(true)
$call StartOpenMode()
$set temp:waitingForNeutrinoStar = true
$call SetStickyFirstPage(2)
$call SubtitleController->SetSubtitlePosition(0.5, 0, 0, 650)

{@Radio} We need to identify the spectral types of these stars to inform our analysis. You should be able to get an approximate categorization using temperature.	$[level2/radio_lady/l2_r_04]
{@Radio} To calculate the temperature, you need to measure magnitude in Blue and Visible filters. 	$[level2/radio_lady/l2_r_05]
{@Radio} The color index will let us estimate the temperature.	$[level2/radio_lady/l2_r_06]
{@Radio} Start by selecting a star on your telescope monitor.	$[level2/radio_lady/l2_r_08]
$start .FirstStarHint

:: FirstStarHint
$wait 10
$if temp:waitingForNeutrinoStar
    {@Radio} Astrid, you still there? Select a possible neutrino source on your display. $[level1/radio_lady/l1_r_19]
    $branch .FirstStarHint
$endif

:: OnNonNeutrinoStarSelected
@trigger    OnStarSelected
@when   temp:waitingForNeutrinoStar
@cutscene
@interrupt
@cooldown 6

$call ClearMonitorSelection()
{@Radio}	Hmmm. That doesn't look a possible neutrino source. Look for objects highlighted in blue.	$[level1/radio_lady/l1_r_20]

:: OnStarSelected
@trigger    OnNeutrinoStarSelected
@when   temp:waitingForNeutrinoStar
@cutscene
@boostScore 100
@interrupt
@once

$set temp:waitingForNeutrinoStar = false
$set temp:waitingForBlueFilter = true
$call LockMonitorFocus()

{@Radio}	Great. Now you’ll need to use the Blue filter to get a Blue magnitude. 	$[level2/radio_lady/l2_r_10]
{@Radio}	Select the blue wavelength filter.	$[level2/radio_lady/l2_r_11]

:: BlueFilterSelected
@trigger OnLabInteraction
@when actorId == "BlueFilter", temp:waitingForBlueFilter
@interrupt
@boostScore 200
@cutscene
@once

$set temp:waitingForBlueFilter = false
$call OpenRefGuidePage("SpectralClass")

{@Radio} Now you can use that temperature to look up the spectral type in your reference guide.	$[level2/radio_lady/l2_r_12]
{@Radio} Look up the spectral type in your manual, and submit the data.	$[level2/radio_lady/l2_r_14]
$set temp:waitingForFirstSubmission = true
$start .WaitingForFirstSubmission

:: WaitingForFirstSubmission
$wait 15
$if temp:waitingForFirstSubmission
    {@Astrid}	Stars are grouped by temperature—O, B, A, F, G, K, M. Hottest to coolest. I just need to pick one.	$[level2/Astrid/l2_a_21]
    $branch .WaitingForFirstSubmission
$endif

:: BlueFilterNOTSelected
@trigger OnLabInteraction
@when   actorId != "BlueFilter", temp:waitingForBlueFilter
@interrupt
@cutscene
@cooldown 10

{@Astrid}	The Blue wavelength filter is there on the monitor.	$[level1/Astrid/l1_a_48]

:: PointsUpdated
@trigger    PointsUpdated
@when   sciencePoints > 0, IsRadioFrequencyAt(137)
@interrupt
@boostScore 300
@cutscene
@once

$start Observatory.ResetSubtitlePosition
$call UnlockMonitorFocus()
$call SetRadioDialLocked(false)
$call SetRefGuidePagesLocked(false)
$call SetChannelActive(IceCube, false)

{@Radio}	Nice job! You're getting the hang of this. 	$[level2/radio_lady/l2_r_15]
// #endregion

//#region Upgrade

:: ClearanceUpgrade
@trigger    PointsUpdated
@when   openIDThresholdHit 
@boostScore 200
@interrupt
@cutscene
@once

$call SetInputState(false)
$call SetRefGuideActive(false)
$wait 4
$call MonitorUI->ShowElement("UpgradeMsg")

$call StopOpenMode()
$call SetInputState(true)
$call SetChannelActive(Unlocks_Active, true)
$set temp:radioChannelTuned = false
$call SetStickyFirstPage(7)

{@Astrid}	I'll bet I am ready for a clearance upgrade. The CERES channels are in my reference guide	$[level2/Astrid/l2_a_22]

:: ClearanceUpgradeTrigger
@trigger    RadioChannelListenStart
@when       channelId == "Unlocks_Active"
@interrupt
@cutscene
@once

$call MonitorUI->HideElement("UpgradeMsg")
$set temp:radioChannelTuned = true
$call SetRadioDialLocked(true)
$call SetRadioFrequency(375, true)
$call SetStickyFirstPage(-1)
$call SetInputState(false)
$call ClearMonitorSelection()
$call LockMonitorFocus()
$call MonitorUI->PlayRadioDownload(2)
$call ConsoleCommandLine->PlayConsoleTextAndWait("UpgradeSystem")
$call SetChannelActive(Unlocks_Active, false)
$call SetRadioFrequency(137)
$call MonitorUI->ShowCERESLogo()
$call MonitorUI->CERESLogoToCorner(0.5)
$wait 1
$call SetInputState(true)

$call ConsoleCommandLine->PlayConsoleText("Day2UpgradeSystem")
$call SetInstrumentUnlocked(SpectrometerInstrument, true)
$wait 1
$call OpenRefGuidePage("Spectrometer")
$wait 11 // wait for the console text to finish

$call ConsoleCommandLine->HideConsole()
$wait 0.1
$call MonitorUI->CERESLogoToCenter(0.5)
$wait 1
$call MonitorUI->HideCERESLogo()
$wait 0.5

$call OpenRefGuidePage("ConstellationHercules")
$wait 1

{@Astrid}	Hmm, Hercules. Just like Elijah's postcard. 	$[level2/Astrid/l2_a_23]
$wait 1
$goto .SetupPuzzleNav

:: SetupPuzzleNav
$branch Observatory.PathToMonitor
$call ConsoleCommandLine->PlayConsoleTextAndWait("Day2ConsoleText")
$call ConsoleCommandLine->HideConsole()
$call SetRefGuideActive(false)
$wait 2
$call StartPuzzleNavigation()
$call SetInputState(true)

// #endregion

//#region Hercules Puzzle 
:: PuzzleNavigationComplete
@trigger    PuzzleNavigationComplete
@cutscene
@once

$call ClearMonitorSelection()
$call UnlockMonitorFocus()
$call SetStickyFirstPage(2)
$call StartPuzzleMode()
$call SetRadioDialLocked(false)

:: HerculesPuzzleComplete
@trigger    CorrectPuzzleSubmission
@when   puzzleName == "Hercules"
@cutscene
@once

$call SetStickyFirstPage(-1)
$call ClearMonitorSelection()
$call StopPuzzleMode()
// $call SetInputState(false)
$call ConsoleCommandLine->PlayConsoleTextAndWait("PlayMessage")
$wait 2
$call SetRefPageActive("ConstellationHercules", false)
$call SetRefPageActive("ConstellationHerculesCompleted", true)
$call OpenRefGuidePage("ConstellationHerculesCompleted")

$call TapeDeck->SetTapeActive(true)
{@Elijah} Astrid. If you’re hearing this, it means you’ve solved Hercules! $[level2/Elijah/l2_e_01]
{@Elijah} If we're on schedule, unencrypted satellite data should start streaming in shortly! $[level2/Elijah/l2_e_02]
{@Astrid} Satellite? What satellite? $[level2/Astrid/l2_a_24]
{@Elijah} Soon CERES will be able to access data from before the Collapse! $[level2/Elijah/l2_e_03]
{@Elijah} Not only that but it will act as a radio repeater and allow us to create an open communication network. $[level2/Elijah/l2_e_04]
{@Elijah} I've been trying to get the satellite online for <i>so</i> long.	$[level2/Elijah/l2_e_05]
{@Elijah} This astronomer, Slavoj, put this satellite up with this encryption. He wanted to make sure that only an astronomer could unlock it. $[level2/Elijah/l2_e_06]
{@Elijah} So these crazy puzzles were made by him. You have to prove yourself. If anyone can solve them, its you. $[level2/Elijah/l2_e_07]
{@Elijah} You'll love this. The satellite is named after a dragon from Slavic folklore. $[level2/Elijah/l2_e_08]
{@Elijah} I found the name in an old library book... Zmei Gorynich. Not sure if I'm saying that right.	$[level2/Elijah/l2_e_09]
{@Elijah} It's sort of poetic, I guess... a dragon guarding over the treasure. 	$[level2/Elijah/l2_e_10]
{@Elijah} Hercules had to fight a dragon, too... but I'm getting ahead of myself. $[level2/Elijah/l2_e_11]
{@Elijah} I hope you're okay Astrid. I miss you. $[level2/Elijah/l2_e_12]
$call ConsoleCommandLine->HideConsole()
$call TapeDeck->SetTapeActive(false)

$wait 1
$call MonitorUI->ShowElement("CeresMsg")
$wait 1
$call SetRadioFrequency(137)
$call SetRadioDialLocked(true)
$call MonitorUI->HideElement("CeresMsg")
$goto .PuzzleNavigationComplete01

:: PuzzleNavigationComplete01
@cutscene

$wait 1
{@Dad} Station 12, this is CERES HQ. Nice work today. $[level2/Dad/l2_d_01]
{@Astrid} Dad, I'm so glad you called. I'm freaking out. I think I know what Elijah is working on!	$[level2/Astrid/l2_a_25]
{@Dad}	{vox-overlap -0.5} Whoa, Astrid, didn't you get my letter? This channel is—	$[level2/Dad/l2_d_02]
{@Astrid} I know, but just listen! Elijah said something about a satellite. It has data from before the Collapse!	$[level2/Astrid/l2_a_26]
{@Dad} Oh, Astrid. The Gorynich satellite is just a wild goose chase. 	$[level2/Dad/l2_d_03]
{@Dad} Or... a wild dragon chase, I guess. $[level2/Dad/l2_d_04]
{@Astrid} Wait a second. You knew about this? 	$[level2/Astrid/l2_a_27]
{@Dad}	Look... it's only rumors. You know how Elijah gets caught up in those old stories. 	$[level2/Dad/l2_d_05]
{@Astrid} What stories? ...Dad, you have to tell me. 	$[level2/Astrid/l2_a_28]
{@Dad} Supposedly, there was a researcher from Slovenia who spent the last years of his life getting a satellite into orbit. $[level2/Dad/l2_d_06]
{@Dad}	This guy was super paranoid, so he built the satellite with tons of extra shielding. There's a chance... a tiny, negligible chance... that it could've survived the Collapse. 	$[level2/Dad/l2_d_07]
{@Dad}	But the satellite is locked. Encrypted with a 5-letter key.	$[level2/Dad/l2_d_08]
{@Dad}	I didn't want to give you false hope.	$[level2/Dad/l2_d_09]
{@Astrid}	But Dad, that actually makes sense. Five letters, five puzzles... I think each puzzle reveals part of the password!	$[level2/Astrid/l2_a_29]
{@Dad}	We can't talk about this now. 	$[level2/Dad/l2_d_10]
{@Astrid}	Why aren't you listening?	$[level2/Astrid/l2_a_30]
{@Dad}	Astrid, the guy who built that satellite was... eccentric, to put it mildly. 	$[level2/Dad/l2_d_11]
{@Dad}	Even if you solve all the puzzles, it probably won't work. 	$[level2/Dad/l2_d_12]
{@Astrid}	Elijah thinks it'll work. 	$[level2/Astrid/l2_a_31]
{@Dad} {vox-overlap -0.1} Elijah is obsessed with this thing! It's not healthy. I don't— $[level2/Dad/l2_d_13]
$call PlayRadioAlert()
{@Monitor} Station 12 and CERES HQ, you have been flagged non-compliant by the Recovery Board. You will lose access to this frequency upon any further violations.	$[level2/monitor/l2_m_01]
{@Monitor} I advise that you review communication protocols if you want to avoid termination. 	$[level2/monitor/l2_m_02]
{@Astrid}	Whoa. Dad, are you there? 	$[level2/Astrid/l2_a_32]
$wait 1
{@Radio} Station 12, we have a new cluster for you to investigate. $[level2/radio_lady/l2_r_17]
{@Astrid} Hang on, I was just talking to my dad... 	$[level2/Astrid/l2_a_33]
{@Radio} I'm taking over for now. Are you able to continue working? 	$[level2/radio_lady/l2_r_18]
$call SetRefGuideActive(false)
{@Astrid} No, signing off for tonight. 	$[level2/Astrid/l2_a_34]

$call StopMusic(1)
$call SetRadioFrequency(100)
$wait 1

$call LoadNextDay()

// #endregion