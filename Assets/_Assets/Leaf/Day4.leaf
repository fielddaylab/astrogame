#basePath	Day4

:: Preload
@function   ScenePreload

$call InitUpdateMasks()
$call ToggleDeskPicture()
$call PreloadDocument("Day4Cal")
$call PreloadDocument("Level1")
$call PreloadDocument("Level2")
$call PreloadDocument("Satellite")
$call PreloadDocument("Panic")
$call PreloadDocument("Seriously")
$call PreloadDocument("Day4Letter")
$call PreloadDocument("DadUrsaPostcard")
$call PreloadDocument("Day4ElijahPostcard")
$call PreloadDocument("Day4Question")
$call SpawnDocument("Day4Cal")
$call SpawnDocument("Level1")
$call SpawnDocument("Level2")
$call SpawnDocument("Satellite")
$call SpawnDocument("Panic")
$call SpawnDocument("Seriously")
$call EnableDocumentClose("Day4ElijahPostcard", false)
$call EnableDocumentClose("DadUrsaPostcard", false)
$call SetInstrumentUnlocked(CoordinateInstrument, true)
$call SetInstrumentUnlocked(PhotometerInstrument, true)
$call SetInstrumentUnlocked(VisibleWavelength, true)
$call SetInstrumentUnlocked(BlueWavelength, true)
$call SetInstrumentUnlocked(InfraredWavelength, true)
$call SetInstrumentUnlocked(ColorInstrument, true)
$call SetInstrumentUnlocked(TemperatureInstrument, true)
$call SetInstrumentUnlocked(SpectrometerInstrument, true)
$call SetInstrumentUnlocked(HistoricalDataInstrument, true)
$start Observatory.ResetSubtitlePosition
$call StopPuzzleMode()
$call StopOpenMode()
$call SetRefPageActive("ConstellationPerseus", false)
$call SetRefPageActive("ConstellationHercules", false)
$call SetRefPageActive("ConstellationLeo", false)
$call SetRefPageActive("ConstellationDracoCompleted", false)
$call SetRefPageActive("ConstellationAndromedaCompleted", false)
$call SetChannelActive(IceCube, false)
$call SetChannelActive(Unlocks_Active, false)
$call SetRadioFrequency(137, true)
$call SetRadioDialLocked(true)
$call MonitorPower->Deactivate()
$call ChapterTitles->PrepareTransition()

$call PreloadMusic("Music.Moonthought")

//#region Spawn Documents

:: BeginDay
@trigger    SceneReady
@boostScore 100

$call PlayMusic("Music.Moonthought", 3)
$call ChapterTitles->DisplayChapterTitles()

$call WaitForMovedToView("DocumentPuzzle")
$call ChapterTitles->FadeOutBackground()
$call ChapterTitles->FinishTransition(1)

$call SetInputState(false)
$wait 1
$call SpawnDocumentToCamera("Day4Letter")
$call SetInputState(true)

{@Astrid}	Jocelyn! She must've gotten my letter.  	$[level4/Astrid/l4_a_01]
{@Astrid}	Wow... she says she loves the work Elijah and I are doing. She thinks I could turn it into a regular column!	$[level4/Astrid/l4_a_02]
{@Astrid}	But the paper won't run a story about the meteor storm unless I can get more details. I need to figure out when and where it's going to happen. 	$[level4/Astrid/l4_a_03]

:: SpawnDoc
@trigger    DocumentInspectEnd
@when   documentId == "Day4Letter"
@interrupt
@cutscene
@once

$call SetInputState(false)
$call SpawnDocumentToCamera("DadUrsaPostcard")
$call SetInputState(true)

{@Astrid} Aw, Dad... It's our constellations! $[level4/Astrid/l4_a_04]

:: DadUrsaPostcardComment
@trigger    DocumentInspectFlip
@when   documentId == "DadUrsaPostcard"
@interrupt
@cutscene
@once

$call EnableDocumentClose("DadUrsaPostcard", true, true)
{@Astrid} Ugh. So much for seeing you next month. $[level4/Astrid/l4_a_07]

:: SpawnDoc2
@trigger    DocumentInspectEnd
@when   documentId == "DadUrsaPostcard"
@interrupt
@cutscene
@once

$call SetInputState(false)
$call SpawnDocumentToCamera("Day4ElijahPostcard")
$call SetInputState(true)

// {@Astrid}	Draco, the dragon constellation. I wonder if Elijah is trying to signal its time for the final puzzle...	$[level4/Astrid/l4_a_08]

:: Day4ElijahPostcard
@trigger    DocumentInspectFlip
@when   documentId == "Day4ElijahPostcard"
@cutscene
@priority High
@interrupt
@once

$call SetInputState(true)
$call EnableDocumentClose("Day4ElijahPostcard", true, true)
$wait 1

{@Astrid}	Yes! Only two more stations, and then Elijah can come home. 	$[level4/Astrid/l4_a_09]
{@Astrid}	A surprise when I finish the Draco puzzle? That's so Elijah. 	$[level4/Astrid/l4_a_10]

//#endregion

//#region Document Puzzle

:: SpawnPuzzleQuestion
@trigger    DocumentInspectEnd
@when   documentId == "Day4ElijahPostcard"
@interrupt
@boostScore 1000
@cutscene
@once

$call SetInputState(false)
$wait 1
$call SetInputState(true)
$call SpawnDocumentToCamera("Day4Question")
$call StartDocumentPuzzle("Day4DocumentPuzzle")
$set temp:docPuzzleSolved = false

{@Astrid}	How can I figure out when the meteor storm is going to happen? 	$[level4/Astrid/l4_a_11]

:: InspectCalendar
@trigger    DocumentInspectStart
@when   documentId == "Day4Cal"
@cutscene
@once

{@Astrid} Almost October. $[level4/Astrid/l4_a_10e]

:: InspectPanic
@trigger    DocumentInspectStart
@when   documentId == "Panic"
@cutscene
@once

{@Astrid}	People will panic if they don't know what's going on.	$[level4/Astrid/l4_a_10d]

:: InspectSatellite
@trigger    DocumentInspectStart
@when   documentId == "Satellite"
@cutscene
@once

{@Astrid} The Gorynich satellite. This upgrade was pretty exciting. $[level4/Astrid/l4_a_10b]

:: InspectNewspaperPostit
@trigger    DocumentInspectStart
@when   documentId == "Seriously"
@cutscene
@once

{@Astrid} If I get the story in the paper, will people take it seriously? $[level4/Astrid/l4_a_10a]

:: IncorrectDocumentResponse
@trigger    DocumentPuzzlePromptStart
@when   answerId == "Day4Letter", !temp:docPuzzleSolved
@interrupt

{@Astrid}	Jocelyn said they'll only publish the story if I have more details. 	$[level4/Astrid/l4_a_12]

:: IncorrectDocumentResponse2
@trigger    DocumentPuzzlePromptStart
@when   answerId == "DadUrsaPostcard", !temp:docPuzzleSolved
@interrupt

{@Astrid}	Dad's so far away. I don't think he can help.	$[level4/Astrid/l4_a_13]

:: IncorrectDocumentResponse3
@trigger    DocumentPuzzlePromptStart
@when   answerId == "Panic", !temp:docPuzzleSolved
@interrupt

{@Astrid}	I drew this. It won't help answer my question though.	$[level1/Astrid/l1_a_g3]

:: EndPuzzleSection
@trigger    DocumentPuzzleSolved
@interrupt
@boostScore 1000
@cutscene
@once

$set temp:docPuzzleSolved = true
$call SetInputState(false)
$call SetChannelActive(IceCube, true)
{@Astrid}	Elijah's right... I need to keep working on these puzzles. Once we unlock the satellite, we'll be able to figure out when the meteor storm is happening. 	$[level4/Astrid/l4_a_14]

$wait 1
$call WaitForMovedToView("Right")
$wait 1

{@Dad}	Hey Astrid, are you there? 	$[level4/Dad/l4_d_01]
{@Astrid} Hey Dad!	$[level4/Astrid/l4_a_15]
{@Dad}	The unencrypted portion of the Gorynich Satellite is making the rounds in CERES, and it checks out. $[level4/Dad/l4_d_02]
{@Astrid} Yeah, this is what I was telling you about. $[level4/Astrid/l4_a_16]
{@Dad} This data seems good. Maybe you're onto something with this satellite thing, Bear. 	$[level4/Dad/l4_d_04]
{@Astrid}	Yeah, I'm really excited about this. 	$[level4/Astrid/l4_a_18]
{@Astrid} {vox-overlap -0.1} Actually, I have news, too. I talked to my friend at the Chicago Telegram. She said she might have a job for me! $[level4/Astrid/l4_a_19]
{@Dad}	Whoa, hold on... a job? What are you talking about?  $[level4/Dad/l4_d_05]
{@Astrid} {vox-overlap -0.3} Well... She thinks I could write an astronomy column for them. And I could go to college there! $[level4/Astrid/l4_a_21]
{@Dad}	Slow down, Astrid. What about <i>this</i> job? There is still so much work to be done for CERES. {vox-overlap -0.1} $[level4/Dad/l4_d_06]
$call PlayRadioAlert()
{@Monitor}	Station 12, this is your third, and final, warning. Cease all personal communications, or we will terminate your connection. 	$[level4/monitor/l4_m_01]
{@Astrid} Friggin' Recovery Board... Okay, okay. Sorry. 	$[level4/Astrid/l4_a_23]
{@Dad}	Uh... Bear, I just...	$[level4/Dad/l4_d_07]
$wait 2

$call SetInputState(true)
{@Radio} Station 12, are you ready for your next assignment? IceCube is detecting high-energy neutrino emission from the area of the Taurus constellation.	$[level4/radio_lady/l4_r_01]
{@Radio} Identification of nearby celestial objects is requested. Uploading area of interest...	$[level4/radio_lady/l4_r_02]
{@Astrid} Uh... sure thing. $[level4/Astrid/l4_a_24]

$branch .SetupNeutrinoNav

:: SetupNeutrinoNav
$call StartMonitorControls()
$call WaitForMovedToView("Monitor")
$call MonitorUI->PlayRadioDownload(2)
$call StartNeutrinoNavigation()

//#endregion

//#region Open Identification

:: NeutrinoNavigationComplete
@trigger    NeutrinoNavigationComplete
@priority High
@boostScore 500
@once

$call StopNeutrinoNavigation()
$call AlignCamToNeutrino()
$call SetInputState(true)
$call StartOpenMode()
$call SetStickyFirstPage(3)
$set temp:thisIsASmallStar = false

{@Radio} Some of these stars are outside the standard spectral types.	$[level4/radio_lady/l4_r_03]
{@Radio} Brown Dwarfs so cold they barely glow- you'll only see them in infrared.	$[level4/radio_lady/l4_r_04]
$start .UnlockFromCeresChannel
{@Radio} Use your Spectrometer to identify them. $[level4/radio_lady/l4_r_05]

::UnlockFromCeresChannel
$call SetRadioDialLocked(false)
$call SetInputState(true)
$start .BDHints

:: BDHints

$wait 15
$if GetFilterState() != 2
    {@Astrid} What's happening here? $[level4/Astrid/l4_a_24b]
    {@Astrid} I should select the infrared filter. $[level4/Astrid/l4_a_24c]
$endif
$goto .BDHints

:: OnYDwarfSelected
@trigger    OnNeutrinoStarSelected
@when  starName == "WISE0410"
@cutscene
@interrupt
@boostScore 500
@once

{@Astrid} Huh, looks like this star has no spectrometer reading... $[level4/Astrid/l4_a_24d]
{@Astrid} Must be too dim to even register. $[level4/Astrid/l4_a_24e]

:: OnDwarf2Selected
@trigger    OnNeutrinoStarSelected
@when  starName == "2MASSJ0355"
@cutscene
@interrupt

$branch .ThisIsASmallStar

:: OnDwarf3Selected
@trigger    OnNeutrinoStarSelected
@when  starName == "Teide 1"
@cutscene
@interrupt

:: ThisIsASmallStar
$if !temp:thisIsASmallStar
    $set temp:thisIsASmallStar = true
    {@Astrid} Wow, those stars are tiny. $[level4/Astrid/l4_a_24a]
$endif

:: ClearanceUpgrade
@trigger    PointsUpdated
@when   openIDThresholdHit
@cutscene
@once

$call SetInputState(false)
$call SetRefGuideActive(false)
$wait 4
$call MonitorUI->ShowElement("UpgradeMsg")

$call StopOpenMode()
$call SetInputState(true)
$call SetChannelActive(Unlocks_Active, true)
$set temp:radioChannelTuned = false
$call SetStickyFirstPage(7)

$call SetRadioDialLocked(false)
{@Astrid}	I'll bet I am ready for a clearance upgrade. The CERES channels are in my reference guide	$[level2/Astrid/l2_a_22]

//#endregion

//#region Upgrade

:: ClearanceUpgradeTrigger
@trigger    RadioChannelListenStart
@when       channelId == "Unlocks_Active"
@interrupt
@cutscene
@once

$call MonitorUI->HideElement("UpgradeMsg")
$set temp:radioChannelTuned = true
$call SetRadioDialLocked(true)
$call SetRadioFrequency(375, true)
$call SetStickyFirstPage(-1)
$call SetInputState(false)
$call ClearMonitorSelection()
$call LockMonitorFocus()
$call MonitorUI->PlayRadioDownload(2)
$call ConsoleCommandLine->PlayConsoleTextAndWait("UpgradeSystem")
$call SetChannelActive(Unlocks_Active, false)
$call SetRadioFrequency(137)
$call MonitorUI->ShowCERESLogo()
$call MonitorUI->CERESLogoToCorner(0.5)
$wait 1
$call SetInputState(true)

$call ConsoleCommandLine->PlayConsoleText("Day4UpgradeSystem")
$wait 1
{@Astrid} With the historical data upgrade, I should able to use the parallax transfer module to calculate absolute magnitude. $[level4/Astrid/l4_a_24ea]
$call OpenRefGuidePage("ParallaxDataTransfer")
$wait 9 // wait for the console text to finish

$call SetInstrumentUnlocked(HistoricalDataModeToggle, true)

$call ConsoleCommandLine->HideConsole()
$wait 0.1
$call MonitorUI->CERESLogoToCenter(0.5)
$wait 1
$call MonitorUI->HideCERESLogo()
$wait 0.5

$call OpenRefGuidePage("ConstellationDraco")
$wait 2.5
$goto .SetupPuzzleNav

:: SetupPuzzleNav
$branch Observatory.PathToMonitor
$call ConsoleCommandLine->PlayConsoleTextAndWait("Day4ConsoleText")
$call ConsoleCommandLine->HideConsole()
$call SetRefGuideActive(false)
$wait 1
$call StartPuzzleNavigation()
$call SetInputState(true)

//#endregion

//#region Hercules Puzzle 

:: PuzzleNavigationComplete
@trigger    PuzzleNavigationComplete
@once

$set temp:WizeCompleted = false
$set temp:EltaninCompleted = false
$call SetRadioDialLocked(false)
$call SetInputState(false)
{@Astrid} Oh, its the Draco puzzle! $[level4/Astrid/l4_a_24f]
$call WaitForMovedToView("Right")
$call ClearMonitorSelection()
//! Dont remove this wait
// We need it because something is messing with the input here 😭
$wait 1
$set temp:DracoPuzzleComplete = false
$call StartPuzzleMode()
$call UnlockMonitorFocus()
$call SetInputState(true)

$wait 8 // waiting for transition sequence to finish

{@Astrid} Null... I guess I can't measure the absolute magnitude. $[level4/Astrid/l4_a_24g]
{@Astrid} One of the stars is missing... Maybe I can see it in another wavelength? $[level4/Astrid/l4_a_24h]
$branch .PuzzleTimeoutHint

:: WizeDataFilled
@trigger    OnPuzzleRowFilled
@when   rowId == 3
@interrupt
@priority High

$set temp:WizeCompleted = true

:: EltaninDataFilled
@trigger    OnPuzzleRowFilled
@when   rowId == 2
@interrupt
@priority High

$set temp:EltaninCompleted = true
$branch .PuzzleTimeoutHint

:: IncorrectPuzzleSubmission
@trigger    IncorrectPuzzleSubmission
@interrupt
@priority High

$if !local:row_2
    $set temp:EltaninCompleted = false
$endif
$if !local:row_3
    $set temp:WizeCompleted = false
$endif
$branch .PuzzleTimeoutHint

:: PuzzleTimeoutHint
$wait 20

$if !temp:WizeCompleted, GetFilterState() != 2, !temp:DracoPuzzleComplete
    {@Astrid} I should select the infrared filter. $[level4/Astrid/l4_a_24i]
    $loop
$elseif !temp:WizeCompleted, !temp:DracoPuzzleComplete
    {@Astrid} Ok, so WISE is spectral type T. That means it's a Brown Dwarf. $[level4/Astrid/l4_a_24j]
    $loop
$elseif !temp:EltaninCompleted, !temp:DracoPuzzleComplete
    {@Astrid} So, Eltanin has no hydrogen... I should use my spectrometer. $[level4/Astrid/l4_a_24k]
    $loop
$endif

:: DracoPuzzleComplete
@trigger    CorrectPuzzleSubmission
@when   puzzleName == "Draco"
@once

$set temp:DracoPuzzleComplete = true
$call SetRefPageActive("ConstellationDraco", false)
$call SetRefPageActive("ConstellationDracoCompleted", true)
$call OpenRefGuidePage("ConstellationDracoCompleted")
$call SetRefGuideActive(false)
$wait 2

$call ClearMonitorSelection()
$call StopPuzzleMode()
$call ConsoleCommandLine->PlayConsoleTextAndWait("PlayMessage")
$call TapeDeck->SetTapeActive(true)
{@Elijah} I just packed my bags for the road... 	$[level4/Elijah/l4_e_01]
{@Elijah} This is so hard. You've already had to wait for your dad, and now I'm leaving too.	$[level4/Elijah/l4_e_02]
{@Elijah} It's not fair, but I don't know what else to do.	$[level4/Elijah/l4_e_03]
{@Elijah} I wish we could make this decision together.	$[level4/Elijah/l4_e_04]
{@Elijah} Anyway... Um, if you're hearing this, you solved Draco. One of my favorites. 	$[level4/Elijah/l4_e_05]
{@Elijah} Hercules was supposed to steal a golden apple from the garden at the end of the world. It was one of his final tasks.	$[level4/Elijah/l4_e_06]
{@Elijah} The catch: the apples were guarded by a dragon. 	$[level4/Elijah/l4_e_07]
{@Elijah} There are so many dragons in folklore. Zmei Gorynich, in Slavic. Ladon, in Hercules' story. And about a million others.	$[level4/Elijah/l4_e_08]
{@Elijah} I wonder what it says about us that all across the world, people tell each other stories about monsters... and the people who fight them. 	$[level4/Elijah/l4_e_09]
{@Elijah} Anyway. Ready for your surprise? 	$[level4/Elijah/l4_e_10]
{@Elijah} Run the program: "DRACO" then look up.	$[level4/Elijah/l4_e_11]
$call ConsoleCommandLine->HideConsole()
$call TapeDeck->SetTapeActive(false)
{@Astrid}	Okay... here goes. 	$[level4/Astrid/l4_a_25]
$call MonitorUI->PowerOff()
$call WaitForMovedToView("Monitor")
$call AimTelescopeAt(0, 360)
$call ConsoleCommandLine->PlayConsoleTextAndWait("LightsMessage")
$call ConsoleCommandLine->HideConsole()
$start Observatory.PathToDesk
$call WaitForMovedToView("DeskView")
$call EndDay4->BeginCutscene()

$wait 2
$call SetDomeGlow(true)
$wait 3

{@Astrid} Oh, a blacklight! Its making the painting glow. 	$[level4/Astrid/l4_a_26]
{@Astrid} The dragon... the meteor storm... 	$[level4/Astrid/l4_a_27]
{@Astrid} Elijah said “the dragon is waking up.” The meteor storm must be coming from the Draco constellation.	$[level4/Astrid/l4_a_28]
{@Astrid} It all makes sense now. In the story, Hercules goes to the garden of World's End to fight the dragon for golden apples...	$[level4/Astrid/l4_a_29]
{@Astrid} All of that talk of the end of the world... He was just talking about the Draco constellation this whole time. $[level4/Astrid/l4_a_30]
{@Astrid} That's why he named this station World's End! It's all part of his story.	$[level4/Astrid/l4_a_30a]
{@Astrid} The Draconids are in October. We don't have as much time as I thought. These aren't the Leonids in November. This is going to happen soon. 	$[level4/Astrid/l4_a_31]
{@Astrid} And the newspaper goes to print next week.	$[level4/Astrid/l4_a_32]
{@Astrid} Even if I send a letter to Jocelyn right now, it won't get to her in time. 	$[level4/Astrid/l4_a_33]

$goto .EndDay

:: EndDay

$wait 1
$call MonitorUI->ShowElement("CeresMsg")
$wait 1
$call SetRadioFrequency(137)
$call SetRadioDialLocked(true)
$call MonitorUI->HideElement("CeresMsg")
$start Observatory.PathToInstruments
$call SetInputState(true)
{@Dad}	Station 12, this is CERES HQ checking in–	$[level4/Dad/l4_d_08]
{@Astrid} Dad! Listen, I figured it out. It's not going to be a Leonid meteor storm. It's the Draconids!	$[level4/Astrid/l4_a_34]
{@Dad}	The.. Draconids?	$[level4/Dad/l4_d_09]
{@Astrid} The Draconids are in two weeks. Everyone's going to panic! 	$[level4/Astrid/l4_a_35]
{@Astrid} It's too late to write to Jocelyn. I think–I think I need to go to the newspaper myself. 	$[level4/Astrid/l4_a_36]
$call PlayRadioAlert()
{@Monitor}	Station 12, Cease and desist all personal communications. 	$[level4/monitor/l4_m_02]
{@Dad} Ugh... the Recovery Board...	$[level4/Dad/l4_d_10]
{@Dad} But Astrid, this is crazy. You can't just run off to Chicago.	$[level4/Dad/l4_d_11]
{@Dad} If you finish the last puzzle, open comms will come online and you can get the word out that way.	$[level4/Dad/l4_d_12]
{@Astrid}	What if it doesn't work? What if something goes wrong?	$[level4/Astrid/l4_a_37]
{@Dad}	That's not your responsibility. You've done enough. Just wait for Elijah, let him handle it. 	$[level4/Dad/l4_d_13]
{@Astrid}	Dad, I've already spent so much time waiting!	$[level4/Astrid/l4_a_38]
$call PlayOneshotRadioAlert() 
{@Dad}	Bear, just calm down. This is what you need to do–	$[level4/Dad/l4_d_14]
$call StopMusic(0)
{@Monitor}	Station 12, your clearance has been revoked. 	$[level4/monitor/l4_m_03]
{@Astrid} {vox-overlap -0.2} Whoa. Wait, just a second–	$[level4/Astrid/l4_a_39]
{@Monitor}{vox-overlap -0.2} Your access is restricted to incoming data only. 	$[level4/monitor/l4_m_04]
{@Astrid} Wait, I just need two more minutes! $[level4/Astrid/l4_a_40]
$wait 1
{@Astrid} Hello? $[level4/Astrid/l4_a_41]
$wait 1
{@Astrid} Dad? $[level4/Astrid/l4_a_42]

$call StopMusic(3)
$wait 3
$call LoadNextDay()

//#endregion