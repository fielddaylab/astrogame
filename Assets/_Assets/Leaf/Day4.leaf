#basePath	Day4

:: Preload
@function   ScenePreload

$call InitUpdateMasks()
$call ToggleDeskPicture()
$call EnableDocumentClose("Day4ElijahPostcard", false)
$call SetInstrumentUnlocked(CoordinateInstrument, true)
$call SetInstrumentUnlocked(PhotometerInstrument, true)
$call SetInstrumentUnlocked(BlueWavelength, true)
$call SetInstrumentUnlocked(InfraredWavelength, true)
$call SetInstrumentUnlocked(ColorInstrument, true)
$call SetInstrumentUnlocked(TemperatureInstrument, true)
$call SetInstrumentUnlocked(SpectrometerInstrument, true)
$call SetInstrumentUnlocked(HistoricalDataInstrument, true)
$start Observatory.ResetSubtitlePosition
$call StopPuzzleMode()
$call StopOpenMode()
$call SetRefPageActive("ConstellationPerseus", false)
$call SetRefPageActive("ConstellationHercules", false)
$call SetRefPageActive("ConstellationLeo", false)
$call SetRefPageActive("ConstellationDracoCompleted", false)
$call SetRefPageActive("ConstellationAndromedaCompleted", false)
$call SetChannelActive(Unlocks_Active, false)
$call SetRadioFrequency(137, true)
$call MonitorPower->Deactivate()
$call ChapterTitles->PrepareTransition()

:: BeginDay
@trigger    SceneReady
@boostScore 100
@who    Astrid

$call PlayMusic("Music.Moonthought", 3)
$call ChapterTitles->DisplayChapterTitles()

$call WaitForMovedToView("DocumentPuzzle")
$call ChapterTitles->FadeOutBackground()
$call ChapterTitles->FinishTransition(1)

$call SetInputState(false)
$wait 1
$call SpawnDocumentToCamera("Day4ElijahPostcard")
$call SetInputState(true)

{@Astrid} Draco! One of my favorite Constellations. $[Astrid/L4/l4d_a_05]

:: Day4ElijahPostcard
@trigger    DocumentInspectFlip
@when   documentId == "Day4ElijahPostcard"
@cutscene
@once

$call SetInputState(true)
$call EnableDocumentClose("Day4ElijahPostcard", true, true)
{@Astrid} He's updated the technology at nine stations… that means he’ll be home soon! $[Astrid/L4/l4d_a_06]
{@Astrid} But—<i>the blue light</i>—what is he talking about? $[Astrid/L4/l4d_a_07]

:: SpawnDoc2
@trigger    DocumentInspectEnd
@when   documentId == "Day4ElijahPostcard"
@interrupt
@cutscene
@once

$call SpawnDocumentToCamera("Day4Letter")

{@Astrid} Jocelyn! She must have gotten my last letter and figured out my new address. $[Astrid/L4/l4d_a_01] 
{@Astrid} She thinks the story of what we are working on here matters. That people will want to know! $[Astrid/L4/l4d_a_02]

:: SpawnDoc
@trigger    DocumentInspectEnd
@when   documentId == "Day4Letter"
@interrupt
@cutscene
@once

$call SetInputState(false)
$call SpawnDocumentToCamera("DadUrsaPostcard")
$call SetInputState(true)

{@Astrid} Oh Dad... Its our constellations. He always did think of us as the big and little dipper. Ursa Major and Ursa Minor. $[Astrid/L4/l4d_a_03] 

:: DadUrsaPostcardComment
@trigger    DocumentInspectFlip
@when   documentId == "DadUrsaPostcard"
@interrupt
@cutscene
@once

{@Astrid} I really don't want to wait another year to see Dad.  $[Astrid/L4/l4d_a_04]

:: SpawnPuzzleQuestion
@trigger    DocumentInspectEnd
@when   documentId == "DadUrsaPostcard"
@interrupt
@boostScore 1000
@cutscene
@once

$call SetInputState(false)
$call Wait(1)
$call SetInputState(true)
$call SpawnDocumentToCamera("Day4Question")
$call StartDocumentPuzzle("Day4DocumentPuzzle")
$set temp:docPuzzleSolved = false

{@Astrid} How can I figure out when the Meteor storm going to take place? $[Astrid/L4/l4d_a_08]

:: IncorrectDocumentResponse
@trigger    DocumentPuzzlePromptStart
@when   answerId == "Day4Letter", !temp:docPuzzleSolved
@interrupt

{@Astrid} Jocelyn said that I can only get the story in the paper and get the word out to everyone if I have more details. $[Astrid/L4/l4d_a_09]

:: IncorrectDocumentResponse2
@trigger    DocumentPuzzlePromptStart
@when   answerId == "DadUrsaPostcard", !temp:docPuzzleSolved
@interrupt

{@Astrid} Dad's so far away. I don't think he's going to be able to help out... $[Astrid/L4/l4d_a_10]

:: EndPuzzleSection
@trigger    DocumentPuzzleSolved
@interrupt
@boostScore 1000
@cutscene
@once

$set temp:docPuzzleSolved = true
$call SetInputState(false)
{@Astrid} That's it... The only thing to do is to keep adding data to CERES and finishing these puzzles.  $[Astrid/L4/l4d_a_11]

$wait 1
$call WaitForMovedToView("Right")
$wait 1

{@Dad} Astrid, are you there? I can't believe you did it. You unlocked the unencrypted portion of the Gorynych Satellite! $[Dad/L4/l4_d_01] 
{@Dad} Now we'll have access to all the data stored on the satellite. $[Dad/L4/l4_d_02]
{@Dad} Star charts, meteor storms, black holes and supernovas. The whole recorded history of the night sky! $[Dad/L4/l4_d_03]

// {@Astrid} Wait a second... meteor storms? That’s what Elijah’s been so worried about. $[Astrid/L4/l4_a_05]
{@Astrid} Maybe we’ll be able to figure out when the storm is coming! $[Astrid/L4/l4_a_06]

{@Dad} Speaking of Elijah... He was supposed to be on his way home by now. $[Dad/L4/l4_d_04]
{@Dad} But I just heard from the CERES station in Tallgrass Prairie National Preserve west of Kansas City. $[Dad/L4/l4_d_05]
{@Dad} They said they had one more job for him... a station near St. Louis that wasn’t on the map. $[Dad/L4/l4_d_06]
{@Dad} They’ve been cut off from supplies for a while. They need food and water. $[Dad/L4/l4_d_07]
{@Dad} Elijah agreed to go and help them. That means it’ll be a bit longer before he gets home. $[Dad/L4/l4_d_08]

{@Astrid} Ugh. So much for solving this mystery together. Eleven cities in two months. The eleven labors of Elijah. $[Astrid/L4/l4_a_07]
{@Astrid} I guess it’s not quite as bad as Hercules... he ended up with twelve. $[Astrid/L4/l4_a_08]

{@Dad} Anyway, you keep up the great work, Little Bear. We’ll talk soon. Over and out. $[Dad/L4/l4_d_09]

$wait 1

{@Radio} CERES HQ to Station Twelve. IceCube is reading a high-energy neutrino emission from the area of the Taurus Constellation. $[Radio/L4/l4_r_01]
$call SetInputState(true)
{@Radio} Identification of nearby celestial objects is requested. Uploading area of interest. $[Radio/L4/l4_r_02]
$branch .SetupNeutrinoNav

::SetupNeutrinoNav
$call WaitForMovedToView("Monitor")
$call MonitorUI->PlayRadioDownload(2)
$call StartNeutrinoNavigation()

:: NeutrinoNavigationComplete
@trigger    NeutrinoNavigationComplete
@once

$call StopNeutrinoNavigation()
$call StartOpenMode()
$call SetStickyFirstPage(3)

:: IdentifiedOneBrownDwarf
@trigger    PointsUpdated
@when   sciencePoints > 0
@cutscene
@once

$call SetInputState(false)
$call ClearMonitorSelection()

$call Wait(2)
{@Radio} CERES HQ to Station Twelve. Our neutrino emission reading has expanded please hold while we update your targeting system.

$goto .UpdateSubmissionArea

:: UpdateSubmissionArea
$call MonitorUI->PlayRadioDownload(2)
$call AddAssetToSubmissionGroup("Aldebaran")
$call AddAssetToSubmissionGroup("Elnath")
$call AddAssetToSubmissionGroup("Alcyone")
$call AddAssetToSubmissionGroup("Tianguan")
$call AddAssetToSubmissionGroup("Chamukuy")
$call AddAssetToSubmissionGroup("Sadr al Tauri")
$call AddAssetToSubmissionGroup("Ain")
$call AddAssetToSubmissionGroup("Omicron Tauri")
$call AddAssetToSubmissionGroup("Atlas")
$call AddAssetToSubmissionGroup("Hyadum")
$call AddAssetToSubmissionGroup("Electra")
$call UpdateOpenIdSubmissions()
$call SetInputState(true)
$call SetRadioFrequency(137)

:: ClearanceUpgrade
@trigger    PointsUpdated
@when   openIDThresholdHit 
@cutscene
@once

$call SetInputState(false)
$call SetRefGuideActive(false)
$call Wait(4)

$call StopOpenMode()
$call SetInputState(true)
$call SetChannelActive(Unlocks_Active, true)
$call SetChannelActive(Unlocks_Inactive, false)
$set temp:radioChannelTuned = false

{@Astrid} It looks like I'm ready for the next level!

$start .UpgradeReminder

:: UpgradeReminder
$call Wait(10)
$if !temp:radioChannelTuned
    {@Astrid} I should tune to 375 mHz on the Radio to upgrade my rig.
    $branch .UpgradeReminder
$endif

:: ClearanceUpgradeTrigger
@trigger    RadioChannelListenStart
@when       channelId == "Unlocks_Active"
@interrupt
@cutscene
@once

$set temp:radioChannelTuned = true
$call SetRadioFrequency(375, true)
$call SnapRadioToChannel()
$call SetRadioDialLocked(true)
$call SetInputState(false)
$call ClearMonitorSelection()
$call MonitorUI->PlayRadioDownload(2)
$call ConsoleCommandLine->PlayConsoleText("UpgradeSystem")
$call SetChannelActive(Unlocks_Active, false)
$call SetRadioDialLocked(false)
$call SetInputState(true)
$call SetChannelActive(Unlocks_Inactive, true)

:: CompleteUpgradeSequence
@trigger    RadioChannelListenStart
@when       channelId == "IceCube", temp:radioChannelTuned
@priority   High
@boostScore 1000
@interrupt
@once

$call SetInputState(false)
$call SetRadioFrequency(137, true)
$call SnapRadioToChannel()
$call SetRadioDialLocked(true)
$call MonitorUI->ShowCERESLogo()
$wait 1

$call MonitorUI->ShowCERESLogo()
$call SetInstrumentUnlocked(HistoricalDataModeToggle, true)
$call SetStickyFirstPage(-1)

{@Radio} Congratulations on being awarded clearance level 4. You are now cleared to use the infrared module on your telescope. $[Radio/L4/l4_r_04]
{@Radio} Please reference your CERES Operator Manual for further information about your equipment. $[Radio/L4/l4_r_05]
{@Radio} Thanking you for being an important part of the CERES Distributed Network of Citizen Observatories. $[Radio/L4/l4_r_06] 
{@Radio} Together, we will map the stars for a better tomorrow. $[Radio/L4/l4_r_07]

$call SetRadioDialLocked(false)
$call MonitorUI->HideCERESLogo()
$call OpenRefGuidePage("ConstellationDraco")
$wait 2.5
$goto .SetupPuzzleNav

:: SetupPuzzleNav
$branch Observatory.PathToMonitor
$call ConsoleCommandLine->PlayConsoleText("Day4ConsoleText")
$call SetRefGuideActive(false)
$wait 1
$call StartPuzzleNavigation()
$call SetInputState(true)

:: PuzzleNavigationComplete
@trigger    PuzzleNavigationComplete
@once

$call SetInputState(false)
$call WaitForMovedToView("Right")
$call ClearMonitorSelection()
// Dont remove this wait
// We need it because something is messing with the input here 😭
$wait 1
$call StartPuzzleMode()
$call SetInputState(true)

:: DracoPuzzleComplete
@trigger    CorrectPuzzleSubmission
@when   puzzleName == "Draco"
@once

$call SetRefPageActive("ConstellationDraco", false)
$call SetRefPageActive("ConstellationDracoCompleted", true)
$call OpenRefGuidePage("ConstellationDracoCompleted")
$call Wait(2)
$call SetRefGuideActive(false)
$call Wait(1)

$call ClearMonitorSelection()
$call StopPuzzleMode()
$call SetInputState(false)
$call ConsoleCommandLine->PlayConsoleText("LightsMessage")
$call EndDay4->BeginCutscene()

$call Wait(2)
$call SetDomeGlow(true)
$call Wait(3)
{@Astrid} Whoa. That’s it. It’s the dragon! $[Astrid/L4/l4_a_09]
{@Astrid} I should’ve guessed. Elijah said “the dragon is coming.” It’s going to be a Draconid meteor storm! $[Astrid/L4/l4_a_10]
{@Astrid} So World's End  must be what Elijah calls his station! World’s End - like the garden of the golden apples from the Hercules myths. $[Astrid/L4/l4_a_03]
{@Astrid} It’s not about the world ending. It’s about, searching for the stars. $[Astrid/L4/l4_a_04] 
// {@Astrid} Wait.... World’s End is a garden? $[Astrid/L4/l4_a_01]
// {@Astrid} This painting is incredible. Elijah is so talented. $[Astrid/L4/l4_a_02] 
// {@Astrid} Maybe he shoulda been a painter instead of a rogue astronomer... $[Astrid/L4/l4_a_02b]
$goto .EndDay

// :: EndDay
// @trigger    CutsceneEnd
// @when   cutsceneId == "EndDay4"
:: EndDay
$call Wait(1)
$call StopMusic(1)
$call LoadNextDay()