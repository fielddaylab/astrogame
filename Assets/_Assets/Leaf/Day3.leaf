#basePath	Day3

:: Preload
@function   ScenePreload
$call InitUpdateMasks()
$call ToggleDeskPicture()
$call SpawnDocument("Day3Cal")
$call SpawnDocument("Level1")
$call SpawnDocument("Level2")
$call SpawnDocument("AnnoyingRadio")
$call EnableDocumentClose("1833", false)
$call EnableDocumentClose("Day3ElijahPostcard", false)
$call SetInstrumentUnlocked(CoordinateInstrument, true)
$call SetInstrumentUnlocked(PhotometerInstrument, true)
$call SetInstrumentUnlocked(VisibleWavelength, true)
$call SetInstrumentUnlocked(BlueWavelength, true)
$call SetInstrumentUnlocked(ColorInstrument, true)
$call SetInstrumentUnlocked(TemperatureInstrument, true)
$call SetInstrumentUnlocked(SpectrometerInstrument, true)
$call StopPuzzleMode()
$call StopOpenMode()
$call SetRefPageActive("ConstellationPerseus", false)
$call SetRefPageActive("ConstellationHercules", false)
$call SetRefPageActive("ConstellationLeoCompleted", false)
$call SetRefPageActive("ConstellationDracoCompleted", false)
$call SetRefPageActive("ConstellationAndromedaCompleted", false)
$call SetChannelActive(IceCube, false)
$call SetChannelActive(Unlocks_Active, false)
$call SetRadioFrequency(137, true)
$call SetRadioDialLocked(true)
$call MonitorPower->Deactivate()
$call ChapterTitles->PrepareTransition()
$start Observatory.ResetSubtitlePosition

//#region Spawn Documents

:: BeginDay
@trigger    SceneReady
@boostScore 100

$call PlayMusic("Music.Dreams", 3)
$call ChapterTitles->DisplayChapterTitles()

$call SetInputState(false)
$call WaitForMovedToView("DocumentPuzzle")
$call ChapterTitles->FadeOutBackground()
$call ChapterTitles->FinishTransition(1)

$wait 1
$call SpawnDocumentToCamera("Day3ElijahPostcard")
$call SetInputState(true)
{@Astrid}	Elijah! Okay... at least I know he's still alive. 	$[level3/Astrid/l3_a_01]

:: Day3ElijahPostcardFlavor
@trigger    DocumentInspectFlip
@when   documentId == "Day3ElijahPostcard"
@cutscene
@once

$call EnableDocumentClose("Day3ElijahPostcard", true, true)
{@Astrid} I've seen your notes about the Leonids? What notes?	$[level3/Astrid/l3_a_02]
{@Astrid} Ugh, if I was supposed to read something, maybe tell me? That reference guide is like four inches thick. 	$[level3/Astrid/l3_a_03]
{@Astrid} Guess I should look for those notes on Leo that Elijah was talking about. $[level3/Astrid/l3_a_04]

:: SpawnPuzzleDocs1833
@trigger    DocumentInspectEnd
@when   documentId == "Day3ElijahPostcard"
@interrupt
@cutscene
@once

$call SetInputState(false)
$wait 1
$call SpawnDocumentToCamera("1833")
$call SetInputState(true)

{@Astrid} Oh, here it is! $[level3/Astrid/l3_a_05a]
{@Astrid} Apparently there was some crazy Leonid meteor storm in 1833. People thought the world was ending. $[level3/Astrid/l3_a_05]

:: 1833FlipDocument
@trigger    DocumentInspectFlip
@when   documentId == "1833"
@interrupt
@cutscene
@once

$call EnableDocumentClose("1833", true, true)
{@Astrid} Ugh, half the words are smudged off! The dangers of iced coffee...  $[level3/Astrid/l3_a_06]

:: SpawnPuzzleDocs2
@trigger    DocumentInspectEnd
@when   documentId == "1833"
@interrupt
@cutscene
@once

$call SetInputState(false)
$wait 1
$call SpawnDocumentToCamera("Day3Dad")
$call SetInputState(true)

{@Astrid} Dad! I haven't heard from him since we argued. $[level3/Astrid/l3_a_07]
{@Astrid} After the CME, so many people are scared of anything unusual in the night sky. $[level3/Astrid/l3_a_08]
{@Astrid} It would be nice if we could all enjoy looking at the stars again. Martha was always telling me to stop stargazing. $[level3/Astrid/l3_a_09]

:: SpawnCMEDrawing
@trigger    DocumentInspectEnd
@when   documentId == "Day3Dad"
@interrupt
@cutscene
@once

$call SpawnDocumentToCamera("CMEDrawing")
{@Astrid}	Most solar flares don't affect the power grid, but we weren't prepared for a full-scale CME... 	$[level3/Astrid/l3_a_15a]

:: SpawnPuzzleDocs3
@trigger    DocumentInspectEnd
@when   documentId == "CMEDrawing"
@interrupt
@boostScore 100
@cutscene
@once

$call SetInputState(false)
$wait 1
$call SpawnDocumentToCamera("Day3Question")
$call SetInputState(true)
$call StartDocumentPuzzle("Day3DocumentPuzzle")
$set temp:docPuzzleSolved = false

{@Astrid} What is Elijah trying to warn people about? $[level3/Astrid/l3_a_10]

// #endregion

//#region Document Puzzle

:: InspectLevel2
@trigger    DocumentInspectStart
@when   documentId == "Level2"
@cutscene
@once

{@Astrid} Clearance Level 2. $[level3/Astrid/l3_a_09a]

:: InspectRadioPostit
@trigger    DocumentInspectStart
@when   documentId == "AnnoyingRadio"
@cutscene
@once

{@Astrid} I wish the Recovery Board would get off my back... I'm trying to help! $[level3/Astrid/l3_a_09b]

:: InspectCalendar
@trigger    DocumentInspectStart
@when   documentId == "Day3Cal"
@cutscene
@once

{@Astrid} September already! Time flies when you're... all alone. $[level3/Astrid/l3_a_09c]

:: IncorrectDocumentResponse
@trigger    DocumentPuzzlePromptStart
@when   answerId == "Day3Dad", !temp:docPuzzleSolved
@interrupt

{@Astrid} No, Elijah hasn't said anything about another CME. $[level3/Astrid/l3_a_15]

:: IncorrectDocumentResponse2
@trigger    DocumentPuzzlePromptStart
@when   answerId == "Day3ElijahPostcard", !temp:docPuzzleSolved
@interrupt

{@Astrid} No, that's not it. Weren't there some notes on that meteor storm drawing? $[level3/Astrid/l3_a_16]

:: IncorrectDocumentResponse3
@trigger    DocumentPuzzlePromptStart
@when   answerId == "CMEDrawing", !temp:docPuzzleSolved
@interrupt

{@Astrid} Hmm... this doesn't help answer my question... $[level1/Astrid/l1_a_g2]

:: CorrectDocumentResponse
@trigger    DocumentPuzzleSolved
@interrupt
@boostScore 1000
@cutscene
@once

$call SetChannelActive(IceCube, true)
$set temp:docPuzzleSolved = true
$call SetInputState(false)

{@Astrid} I guess... Elijah thinks this is supposed to happen again? Another Leonid storm? 	$[level3/Astrid/l3_a_12]
{@Astrid} This would totally freak people out. But the Leonids aren't until November. Plenty of time to get the word out. Why is he so stressed? $[level3/Astrid/l3_a_14]

$wait 1
$call MoveToView("Right")
$wait 1

{@Dad} Astrid, this is Dad. You there?	$[level3/Dad/l3_d_01]
{@Astrid} Yeah, I'm here.	$[level3/Astrid/l3_a_17]
{@Dad} You won't believe this. I pulled some strings. So, we have a few minutes to talk. 	$[level3/Dad/l3_d_02]
{@Astrid} Like, actually talk? I don't want to get you in trouble again.	$[level3/Astrid/l3_a_18]
{@Dad} That wasn't your fault, Bear. Of course you'd want to help Elijah.	$[level3/Dad/l3_d_03]
{@Dad} But our work at CERES... it's important. It has to come first. 	$[level3/Dad/l3_d_04]
{@Dad} We need a complete map of the stars to continue our work. You know the CME destroyed all our digital archives, we're starting from scratch. 	$[level3/Dad/l3_d_05]
{@Dad} All our scientific knowledge is so behind...	$[level3/Dad/l3_d_06]
{@Astrid} I get it. But... Dad, this satellite is important too. 	$[level3/Astrid/l3_a_19]
{@Astrid} According to Elijah's notes, there's going to be a huge meteor storm.	$[level3/Astrid/l3_a_20]
{@Astrid} Auroras, red moons, eclipses, meteor storms... people are so suspicious about what's happening in the sky. 	$[level3/Astrid/l3_a_21]
{@Astrid} All this talk of UFOs and conspiracies is getting unhinged. 	$[level3/Astrid/l3_a_22]
{@Astrid} Do you remember the panic on the eclipse last year? We can't have that happen again.	$[level3/Astrid/l3_a_23]
{@Astrid} We can use the satellite to figure out what's coming and warn people. 	$[level3/Astrid/l3_a_24]
{@Dad}	Warn them? Astrid, there are meteor showers all the time. These aren't omens, they are natural phenomena. $[level3/Dad/l3_d_07]
{@Astrid} Dad, are you even listening? This isn't a meteor shower. Meteor storm. 	$[level3/Astrid/l3_a_25]
{@Astrid} Like... the sky is falling, fire-and-brimstone type storm. I know meteors are harmless, but not everyone does. There is going to be panic. $[level3/Astrid/l3_a_26]
{@Dad} Look. I don't want to argue again. $[level3/Dad/l3_d_08]
{@Dad} If the Recovery Board doesn't like our results, we'll get shut down. I'll have to leave all my work and come home. $[level3/Dad/l3_d_09]

$wait 1

{@Astrid} You'll <i>have</i> to come home? $[level3/Astrid/l3_a_27]
{@Astrid} I thought you were planning on it. $[level3/Astrid/l3_a_28]
{@Dad} What do you mean? $[level3/Dad/l3_d_10]
{@Astrid} I mean... Antarctic winter is almost over, right? In October, planes can get to the South Pole again. You can finally come home. $[level3/Astrid/l3_a_29]
{@Dad} Yeah. Right. Probably. $[level3/Dad/l3_d_11]
{@Astrid} What? $[level3/Astrid/l3_a_30]
{@Dad}	It's just... there's so much that we still need to do here. $[level3/Dad/l3_d_12]
{@Astrid} Ugh! Dad! Are you serious? $[level3/Astrid/l3_a_31]
{@Dad}	Try to understand, Astrid. It's a different world now. If I leave, I don't know when I'll be able to get transport back. $[level3/Dad/l3_d_13]
{@Astrid} I've been waiting for you to come home for two years. $[level3/Astrid/l3_a_32]
{@Astrid} I just can't... $[level3/Astrid/l3_a_33]
{@Dad} I'll come back as soon as I can, Astrid. Time's up. I love you. $[level3/Dad/l3_d_14]
{@Radio} CERES HQ to Station 12. IceCube is detecting a high-energy neutrino emission from the area of the Orion constellation.	$[level3/radio_lady/l3_r_01]
{@Radio} Identification of nearby celestial objects is requested. $[level3/radio_lady/l3_r_02]
{@Radio} Uploading area of interest... $[level3/radio_lady/l3_r_02b]

$goto .SetupNeutrinoNav

// #endregion

//#region Open Identification
:: SetupNeutrinoNav
$call StartMonitorControls()
$call WaitForMovedToView("Monitor")
$call MonitorUI->PlayRadioDownload(2)
$call StartNeutrinoNavigation()
$call SetInputState(true)

:: NeutrinoNavigationComplete
@trigger    NeutrinoNavigationComplete
@cutscene
@once

$call SetStickyFirstPage(1)
$call StopNeutrinoNavigation()
$call AlignCamToNeutrino()
$call StartOpenMode()
$call SetInputState(false)
{@Radio}	The star's spectra is like its fingerprint. Each star has unique color, temperature, and elements. 	$[level3/radio_lady/l3_r_03]
{@Radio}	Using the spectrometer gives us detailed information about what elements are in a star. 	$[level3/radio_lady/l3_r_04]
$call ConsoleCommandLine->PlayConsoleTextAndWait("LoadHistData")
$wait 1
{@Radio} Whoa. $[level3/radio_lady/l3_r_05]
$wait 1
{@Radio} What is all this? $[level3/radio_lady/l3_r_06]
{@Astrid} Hey, um, are you still talking to me? $[level3/Astrid/l3_a_35]
{@Radio} Please stand by. $[level3/radio_lady/l3_r_07]
{@Radio} This is... this is incredible! Are you seeing this? $[level3/radio_lady/l3_r_08]
{@Radio} It's some kind of historical data packet. I can't believe it. A portion of the Gorynich satellite is online! $[level3/radio_lady/l3_r_10]
{@Astrid} Whoa. Unlocking the last puzzle actually worked. $[level3/Astrid/l3_a_36]
$call ConsoleCommandLine->HideConsole()
{@Radio} Station 12, come in. Sorry for the delay. $[level3/radio_lady/l3_r_11]
{@Astrid} Uh, no problem. Any updates, or...? $[level3/Astrid/l3_a_38]
{@Radio} Um... please stand by while I look this over. Can you work on identifying the elements in the target region? $[level3/radio_lady/l3_r_11a]
{@Astrid} Sure... $[level3/Astrid/l3_a_38a]
{@Radio} ...yeah come check this out... $[level3/radio_lady/l3_r_11b]
$call SetRadioDialLocked(false)
$call SetChannelActive(IceCube, false)
$call SetInputState(true)

//#endregion

//#region Upgrade
:: ClearanceUpgrade
@trigger    PointsUpdated
@when   openIDThresholdHit 
@cutscene
@once

$call SetInputState(false)
$call SetRefGuideActive(false)
$wait 4

$call StopOpenMode()
$call SetChannelActive(Unlocks_Active, true)
$set temp:radioChannelTuned = false
$call SetStickyFirstPage(7)

$call MonitorUI->ShowElement("CeresMsg")
$wait 1
$call SetRadioFrequency(137)
$call MonitorUI->HideElement("CeresMsg")
$wait 1
$call SetRadioDialLocked(true)
{@Radio} Astrid, come in, are you there? $[level3/radio_lady/l3_r_13a]
{@Astrid} Hey! Yeah, I'm here. What happened?	$[level3/Astrid/l3_a_38b]
{@Radio} Well, long story, but it looks like your station is receiving historical observations from a surviving satellite.  $[level3/radio_lady/l3_r_13b]
{@Radio} So... you have been cleared to use the parallax module. $[level3/radio_lady/l3_r_13c]
{@Radio} This will allow you to measure <b>parallax</b>, so that you can determine the distance of stars from Earth.	$[level3/radio_lady/l3_r_13]
{@Astrid} Sick. Anything else? Like... maybe any data on a giant meteor storm later this year? 	$[level3/Astrid/l3_a_40]
{@Radio} I fail to understand how that's relevant. $[level3/radio_lady/l3_r_14]
{@Astrid} Never mind. $[level3/Astrid/l3_a_41]
$call MonitorUI->ShowElement("UpgradeMsg")
$call SetRadioDialLocked(false)
$call SetInputState(true)
$wait 1

{@Astrid} Yes! We're halfway there, Elijah. Part of the satellite is already online! $[level3/Astrid/l3_a_43]
{@Astrid} Guess we're still good together... even if we're not technically together. 	$[level3/Astrid/l3_a_44]
{@Astrid} Ugh. This long distance stuff is giving me a headache. $[level3/Astrid/l3_a_45]

:: ClearanceUpgradeTrigger
@trigger    RadioChannelListenStart
@when       channelId == "Unlocks_Active"
@interrupt
@cutscene
@once

$call MonitorUI->HideElement("UpgradeMsg")
$set temp:radioChannelTuned = true
$call SetRadioDialLocked(true)
$call SetRadioFrequency(375, true)
$call SetStickyFirstPage(-1)
$call SetInputState(false)
$call ClearMonitorSelection()
$call LockMonitorFocus()
$call MonitorUI->PlayRadioDownload(2)
$call ConsoleCommandLine->PlayConsoleTextAndWait("UpgradeSystem")
$wait 1

$call SetChannelActive(Unlocks_Active, false)
$call SetRadioFrequency(137)
$call MonitorUI->ShowCERESLogo()
$call MonitorUI->CERESLogoToCorner(0.5)
$wait 1
$call SetInputState(true)

$call ConsoleCommandLine->PlayConsoleText("Day3UpgradeSystem")
$call OpenRefGuidePage("HistoricalData")

$call SetInstrumentUnlocked(InfraredWavelength, true)
$call SetInstrumentUnlocked(HistoricalDataInstrument, true)

$call ConsoleCommandLine->HideConsole()
$wait 0.1
$call MonitorUI->CERESLogoToCenter(0.5)
$wait 1
$call MonitorUI->HideCERESLogo()
$wait 0.5

$call OpenRefGuidePage("ConstellationLeo")
$wait 1

{@Astrid} Leo... the lion. 	$[level3/Astrid/l3_a_46]
{@Astrid} Ok, Elijah. Let's see what you left me to work with.	$[level3/Astrid/l3_a_47]
$goto .SetupPuzzleNav

:: SetupPuzzleNav
$branch Observatory.PathToMonitor
$call ConsoleCommandLine->PlayConsoleTextAndWait("Day3ConsoleText")
$call ConsoleCommandLine->HideConsole()
$call SetRefGuideActive(false)
$wait 1
$call StartPuzzleNavigation()
$call SetInputState(true)

//#endregion

//#region Hercules Puzzle 
:: PuzzleNavigationComplete
@trigger    PuzzleNavigationComplete
@cutscene
@once

$call SetRadioDialLocked(false)
$call SetInputState(false)
$call WaitForMovedToView("Right")
$call ClearMonitorSelection()
//! Dont remove this wait
// We need it because something is messing with the input here 😭
$wait 1
$call StartPuzzleMode()
$call UnlockMonitorFocus()
$wait 5
$call SetInputState(true)

$set temp:LeoPuzzleStarted = true
{@Astrid} Elijah figured out that Zosma isn’t the nearest star.	$[level3/Astrid/l3_a_48]
{@Astrid} Now that I've got the parallax data, I can finish what he started.	$[level3/Astrid/l3_a_49]

:: EnablePlayerInput
$call SetInputState(true)

:: FirstParalax
@trigger    OnStarSelected
@when   temp:LeoPuzzleStarted
@boostScore 200
@interrupt
@cutscene
@once

$call OpenRefGuidePage("HistoricalData")
{@Astrid}	Dad taught me about parallax when I was a kid. 	$[level3/Astrid/l3_a_50]
{@Astrid}	As Earth orbits the Sun, our point of view shifts. 	$[level3/Astrid/l3_a_51]
{@Astrid}	When we look at a nearby star from two different positions, months apart, the star seems to... wiggle slightly against the background stars.	$[level3/Astrid/l3_a_52]
{@Astrid}	That's parallax. The closer the star, the bigger the shift. The farther away it is, the smaller the shift.	$[level3/Astrid/l3_a_53]
{@Astrid}	Now that the satellite is online, I've got access to years of data. That means I can use parallax to figure out how far away each star is!	$[level3/Astrid/l3_a_54]

:: FirstInfrared
@trigger OnLabInteraction
@when   actorId == "InfraredFilter", temp:LeoPuzzleStarted
@boostScore 100
@interrupt
@cutscene
@once

{@Astrid}	Visible light shows the glowing stuff, but infrared is like heat vision.	$[level3/Astrid/l3_a_55]
{@Astrid}	I can't see visible light through space dust, but I can see infrared—it cuts right through. 	$[level3/Astrid/l3_a_56]
{@Astrid}	Wait… this one’s brightest in infrared? 	$[level3/Astrid/l3_a_57]
{@Astrid}	That means I won’t see much in the visible wavelengths, but with the infrared filter, it should stand out.	$[level3/Astrid/l3_a_58]

:: LeoPuzzleComplete
@trigger    CorrectPuzzleSubmission
@when   puzzleName == "Leo"
@cutscene
@once

$call StopPuzzleMode()
$call SetInputState(false)
$call ClearMonitorSelection()
$call ConsoleCommandLine->PlayConsoleTextAndWait("PlayMessage")
$call SetRefPageActive("ConstellationLeo", false)
$call SetRefPageActive("ConstellationLeoCompleted", true)
$call OpenRefGuidePage("ConstellationLeoCompleted")

$wait 1

$call TapeDeck->SetTapeActive(true)
{@Elijah}	Astrid. If you're hearing this, you solved Leo!	$[level3/Elijah/l3_e_01]
{@Elijah}	Just two more puzzles, and we'll be able to unlock everything... All the data we need and the means to share it freely. 	$[level3/Elijah/l3_e_02]
{@Elijah}	No more big brother listening to us. 	$[level3/Elijah/l3_e_03]
{@Elijah}	That means we'll have unmonitored stations. We'll be able to talk whenever we want! 	$[level3/Elijah/l3_e_04]
{@Elijah}	Right now, as I'm recording this, it all seems impossible. 	$[level3/Elijah/l3_e_05]
{@Elijah}	But if anyone can do the impossible, you can. 	$[level3/Elijah/l3_e_06]
{@Elijah}	(*sighs*) I wish I could stay here. 	$[level3/Elijah/l3_e_07]
{@Elijah}	I promise, I'll come back as soon as I can.	$[level3/Elijah/l3_e_08]
		
$call ConsoleCommandLine->HideConsole()
$call TapeDeck->SetTapeActive(false)

{@Astrid}	Ugh. This sounds so familiar.	$[level3/Astrid/l3_a_59]
{@Astrid}	But even if we figure out everything about the meteor storm, how will it get people's attention and explain what to expect? 	$[level3/Astrid/l3_a_61]
{@Astrid}	Hmm... I wonder if Jocelyn still works for the newspaper in Chicago.	$[level3/Astrid/l3_a_62]
{@Astrid}	They probably won't run a story with so much missing information.	$[level3/Astrid/l3_a_63]
{@Astrid}	"Breaking news: my boyfriend says the sky is falling." Yeah, right. 	$[level3/Astrid/l3_a_64]
{@Astrid}	But I did tell Jocelyn I'd write her as soon as I made it here... oops. 	$[level3/Astrid/l3_a_65]
{@Astrid}	Guess I've got another letter to write. 	$[level3/Astrid/l3_a_66]

$goto .EndDay

:: EndDay
$wait 1
$call StopMusic(1)
$call LoadNextDay()

//#endregion