#basePath	Day3

:: Preload
@function   ScenePreload
$call InitUpdateMasks()
$call ToggleDeskPicture()
$call EnableDocumentClose("Day3ElijahPostcard", false)
$call SetInstrumentUnlocked(CoordinateInstrument, true)
$call SetInstrumentUnlocked(PhotometerInstrument, true)
$call SetInstrumentUnlocked(BlueWavelength, true)
$call SetInstrumentUnlocked(ColorInstrument, true)
$call SetInstrumentUnlocked(TemperatureInstrument, true)
$call SetInstrumentUnlocked(SpectrometerInstrument, true)
$call SpawnDocument("1833")
$call StopPuzzleMode()
$call StopOpenMode()
$call SetRefPageActive(14, false)
$call SetRefPageActive(16, false)
$call SetRefPageActive(19, false)
$call SetRefPageActive(21, false)
$call SetRefPageActive(23, false)
$call SetRadioFrequency(137, true)
$call SetChannelActive(Unlocks_Active, false)
$call MonitorPower->Deactivate()
$call ChapterTitles->PrepareTransition()
$start Observatory.ResetSubtitlePosition

:: BeginDay
@trigger    SceneReady
@boostScore 100
@who    Astrid

$call PlayMusic("Music.Moonthought", 3)
$call ChapterTitles->DisplayChapterTitles()

$call SetInputState(false)
$call WaitForMovedToView("DocumentPuzzle")
$call ChapterTitles->FadeOutBackground()
$call ChapterTitles->FinishTransition(1)

$call SetInputState(true)
$wait 1
$call SpawnDocumentToCamera("Day3ElijahPostcard")

:: Day3ElijahPostcardFlavor
@trigger    DocumentInspectFlip
@when   documentId == "Day3ElijahPostcard"
@cutscene
@once

$call EnableDocumentClose("Day3ElijahPostcard", true, true)
{@Astrid} I don’t get it. We need to warn people? About what? $[Astrid/L3/l3_a_01]
{@Astrid} Ugh. Elijah, I love you, but I could really use less poetry and more information. $[Astrid/L3/l3_a_02]

:: SpawnPuzzleDocs2
@trigger    DocumentInspectEnd
@when   documentId == "Day3ElijahPostcard"
@interrupt
@cutscene
@once

$call SetInputState(false)
$call Wait(1)
$call SpawnDocumentToCamera("Day3Dad")
$call SetInputState(true)

{@Astrid} Dad... I'm so glad to hear more from him than the few little blips on the radio. $[Astrid/L3/l3_a_03]

:: SpawnPuzzleDocs3
@trigger    DocumentInspectEnd
@when   documentId == "Day3Dad"
@interrupt
@boostScore 100
@cutscene
@once

$call SetInputState(false)
$call Wait(1)
$call SpawnDocumentToCamera("Day3Question")
$call SetInputState(true)
$call StartDocumentPuzzle("Day3DocumentPuzzle")
$set temp:docPuzzleSolved = false

{@Astrid} What is Elijah trying to warn people about?

:: DocumentInspect1833
@trigger    DocumentInspectStart
@when   documentId == "1833"
@cutscene
@once

{@Astrid} Apparently there was some crazy meteor shower - meteor storm - in 1833. Looks like it came from Leo. $[Astrid/L3/l3d_a_01] 
$goto .PostInspect1833

:: PostInspect1833
$call EnableDocumentClose("1833", true, true)

:: IncorrectDocumentResponse
@trigger    DocumentPuzzlePromptStart
@when   answerId == "Day3Dad", !temp:docPuzzleSolved
@interrupt

{@Astrid} No, Elijah hasn't said anything about another CME. $[Astrid/L3/l3d_a_04] 

:: IncorrectDocumentResponse2
@trigger    DocumentPuzzlePromptStart
@when   answerId == "Day3ElijahPostcard", !temp:docPuzzleSolved
@interrupt

{@Astrid} No, that's not it. Weren't there some notes on that picture he sent? $[Astrid/L3/l3d_a_05]

:: CorrectDocumentResponse
@trigger    DocumentPuzzleSolved
@interrupt
@boostScore 1000
@cutscene
@once

$set temp:docPuzzleSolved = true
$call SetInputState(false)

{@Astrid} I guess... Elijah thinks this is supposed to happen again? Another Leonid storm? $[Astrid/L3/l3d_a_02] 
{@Astrid} The Leonids take place in November. We should have plenty of time to get the word out... why is he so stressed? $[Astrid/L3/l3d_a_03] 

$call Wait(1)
$call MoveToView("Right")
$call Wait(1)

{@Dad} Astrid, this is Ursa Major. You there? $[Dad/L3/l3_d_1]

{@Astrid} Dad! $[Astrid/L3/l3_a_05] 

{@Dad} Sorry I've been out of touch the last few weeks, but we have a short window to talk now. $[Dad/L3/l3_d_2]
{@Dad} I got your letter about Elijah, and all those cryptic notes you found. $[Dad/L3/l3_d_3]
{@Dad} You know, we are under so much scrutiny here to get resources for our work that $[Dad/L3/l3_d_4] 
{@Dad} we <i>really</i> need to be on the same page with our efforts or we could be shut down. And this work matters. $[Dad/L3/l3_d_5] 

{@Astrid} I get it, I just... I think he might have something here. $[Astrid/L3/l3_a_06]

{@Dad} I know Elijah thinks this side quest is important but... That kid... $[Dad/L3/l3_d_6]

$call Wait(1)

{@Astrid} When do you think you're gonna be able to come home? $[Astrid/L3/l3_a_07] 

{@Dad} Oh kiddo, I miss you too. The last transport back is in a few months. $[Dad/L3/l3_d_7] 
{@Dad} Hopefully I can get through some of this work before the end of the season. $[Dad/L3/l3_d_8] 

{@Astrid} Dad! If you don't get back this season, you'll have to overwinter another year! I just can't... $[Astrid/L3/l3_a_08]

{@Dad} Astrid... I'll do what I can. Time's up. I love you. $[Dad/L3/l3_d_9]

$call Wait(1)

{@Radio} CERES HQ to Station Twelve. IceCube is reading a high-energy neutrino emission from the area of the Orion Constellation. $[Radio/L3/l3_r_01]
{@Radio} Identification of nearby celestial objects is requested. Uploading area of interest. $[Radio/L3/l3_r_02]
$goto .SetupNeutrinoNav

:: SetupNeutrinoNav
$call WaitForMovedToView("Monitor")
$call SetInputState(true)
$call MonitorUI->PlayRadioDownload(2)
$call StartNeutrinoNavigation()

:: NeutrinoNavigationComplete
@trigger    NeutrinoNavigationComplete
@once

$call StopNeutrinoNavigation()
$call StartOpenMode()
$call SetStickyFirstPage(2)

:: ClearanceUpgrade
@trigger    PointsUpdated
@when   openIDThresholdHit 
@cutscene
@once

$call SetInputState(false)
$call SetRefGuideActive(false)
$call Wait(4)

$call StopOpenMode()
$call SetInputState(true)
$call SetChannelActive(Unlocks_Active, true)
$call SetChannelActive(Unlocks_Inactive, false)
$set temp:radioChannelTuned = false

{@Astrid} It looks like I'm ready for the next level!

$start .UpgradeReminder

:: UpgradeReminder
$call Wait(10)
$if !temp:radioChannelTuned
    {@Astrid} I should tune to 375 mHz on the Radio to upgrade my rig.
    $branch .UpgradeReminder
$endif

:: ClearanceUpgradeTrigger
@trigger    RadioChannelListenStart
@when       channelId == "Unlocks_Active"
@interrupt
@cutscene
@once

$call SetRadioDialLocked(true)
$call SnapRadioToChannel()
$call SetChannelActive(Unlocks_Active, false)
$call SetChannelActive(Unlocks_Inactive, true)
$set temp:radioChannelTuned = true
$call SetInputState(false)
$call MonitorUI->PlayRadioDownload(2)

$call Wait(1)
$call ClearMonitorSelection()
$call MonitorUI->ShowCERESLogo()
$call SetInstrumentUnlocked(InfraredWavelength, true)
$call SetInstrumentUnlocked(HistoricalDataInstrument, true)
$call Wait(2)
$call ConsoleCommandLine->PlayConsoleText("LoadHistData")

$call SetStickyFirstPage(-1)
$call OpenRefGuidePage("HistoricalData")

{@Radio} Congratulations on being awarded clearance <b>level 3</b>. You are now cleared to use the historical data module. $[Radio/L3/l3_r_04]
{@Radio} This will allow you to measure parallax over a period of time so that you can determine the distance of the stars. $[Radio/L3/l3_r_05]
{@Radio} You have also been cleared to use the infrared filter. $[Radio/L3/l3_r_06] 
{@Radio} Please reference your CERES Operator Manual for further information about your equipment. $[Radio/L3/l3_r_07]
// {@Radio} Thanking you for being an important part of the CERES Distributed Network of Citizen Observatories. $[Radio/L3/l3_r_08] 
// {@Radio} Together, we will map the stars for a better tomorrow. $[Radio/L3/l3_r_09]

$call SetRadioFrequency(137)
$call MonitorUI->HideCERESLogo()
$call Wait(1)

{@Astrid} Wait, does this mean that Elijah got a satellite uplink working? Oh man, Dad is going to be so surprised. $[Astrid/L3/l3_a_13]
// {@Astrid} How did he do it? $[Astrid/L3/l3_a_14] 
{@Astrid} I bet he put it together out of all this old tech lying around. We used to have so much fun wiring up old radios. $[Astrid/L3/l3_a_15]
//TODO
$call OpenRefGuidePage("ConstellationLeo")
$call Wait(1)

{@Astrid} Leo... the lion. I think I'm ready to wrestle my way through this one. $[Astrid/L3/l3_a_16] 
{@Astrid} If I can just figure out this encryption key its going to really... well, I'm not sure. $[Astrid/L3/l3_a_17] 
{@Astrid} Stop the "end of the world" or something? $[Astrid/L3/l3_a_18] 
{@Astrid} (*Sigh*) I can't really figure that out right now. Back to astronomy. This is pretty fun no matter what happens. $[Astrid/L3/l3_a_19] 
$goto .SetupPuzzleNav

:: SetupPuzzleNav
$branch Observatory.PathToMonitor
$call ConsoleCommandLine->PlayConsoleText("Day3ConsoleText")
$call SetRefGuideActive(false)
$wait 1
$call StartPuzzleNavigation()
$call SetInputState(true)

:: PuzzleNavigationComplete
@trigger    PuzzleNavigationComplete
@cutscene
@once

$call SetInputState(false)
$call WaitForMovedToView("Right")
$call ClearMonitorSelection()
// Dont remove this wait
// We need it because something is messing with the input here 😭
$wait 1
$call StartPuzzleMode()
$call SetInputState(true)

$set temp:LeoPuzzleStarted = true
{@Astrid} Elijah had figured out that Zosma isn’t the nearest star... $[Astrid/L3/l3_a_20]
{@Astrid} Now that I've got that parallax data, I can finish what he started. $[Astrid/L3/l3_a_21]

:: EnablePlayerInput
$call SetInputState(true)

:: FirstParalax
@trigger    OnStarSelected
@when   temp:LeoPuzzleStarted
@boostScore 200
@interrupt
@cutscene
@once

$call OpenRefGuidePage("HistoricalData")

{@Astrid} From what I remember, when Earth orbits the Sun, our point of view shifts. $[Astrid/L3/l3_a_22] 
{@Astrid} And when we look at a nearby star from two different positions months apart, it seems to move slightly against the background stars. $[Astrid/L3/l3_a_23]
{@Astrid} That's parallax. The closer the star, the bigger the shift. The farther away it is, the smaller the shift. $[Astrid/L3/l3_a_24]
{@Astrid} Now that I have this data I can figure out the distance from the stars. $[Astrid/L3/l3_a_25] 
{@Astrid} We couldn'tve figured this out without years of data that was lost. $[Astrid/L3/l3_a_26] 

:: FirstInfrared
@trigger OnLabInteraction
@when   actorId == "InfraredFilter", temp:LeoPuzzleStarted
@boostScore 100
@interrupt
@cutscene
@once

{@Astrid} Infrared filter, cool. $[Astrid/L3/l3_a_27]
{@Astrid} I can't see visible light through space dust, but I can see infrared—it cuts right through. $[Astrid/L3/l3_a_28] 
{@Astrid} Visible light shows the glowing stuff, but infrared is like heat vision. $[Astrid/L3/l3_a_29]
{@Astrid} Wait… this one’s brightest in infrared? $[Astrid/L3/l3_a_30] 
{@Astrid} That means I won’t see much in the visible wavelengths, but with the infrared filter, it should stand out. $[Astrid/L3/l3_a_31]

:: LeoPuzzleComplete
@trigger    CorrectPuzzleSubmission
@when   puzzleName == "Leo"
@cutscene
@once

$call ClearMonitorSelection()
$call StopPuzzleMode()
$call SetInputState(false)
$call ConsoleCommandLine->PlayConsoleText("PlayMessage")
$call SetRefPageActive(18, false)
$call SetRefPageActive(19, true)
$call OpenRefGuideToPage(19)

$call Wait(1)

$call TapeDeck->SetTapeActive(true)
{@Elijah} Well… if Leo’s puzzle opened, that means the historical data made it through. Something’s working. $[Elijah/L3/l3_e_01]
{@Elijah} That would mean that part of the system’s still alive. $[Elijah/L3/l3_e_02]
{@Elijah} Alright. Stay focused. Keep movin'. $[Elijah/L3/l3_e_03]
$call TapeDeck->SetTapeActive(false)

$goto .EndDay

:: EndDay
$call Wait(1)
$call StopMusic(1)
$call LoadNextDay()